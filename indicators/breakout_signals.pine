//@version=6
// Breakout Signals v4
// 仿「Breakout alert (hugo)」：共識 K 棒 + Interm / Near T 支撐壓力
// 仿「買賣訊號」：創「階段」根新低 / 新高 → 第一根收盤突破那根 K 的高 / 低點 → EMA 確認
// 設計說明：indicators/breakout_signals.md
// 不指定 scale：跟 K 棒共用同一個價格刻度。指定 scale.right 反而會另開一個刻度，拖動圖表時就會跟 K 棒分離
indicator("Breakout Signals", shorttitle="BO Signals", overlay=true, max_lines_count=20, max_labels_count=20)

// ═════════════════ ⓪ 版面 ═════════════════
grpV   = "⓪ 版面"
layout = input.string("自訂", "版面模式", options=["自訂", "只看訊號", "訊號＋支撐壓力", "全部顯示"], group=grpV,
     tooltip="自訂：照下面每一項的開關。其他模式會直接決定畫哪些東西（買賣訊號的開關、外觀和表格位置仍照下面設定）")

// ═════════════════ ① 買賣訊號 ═════════════════
grpS       = "① 買賣訊號"
stageLen   = input.int(20, "階段", minval=2, group=grpS, tooltip="創前 N 根新低 / 新高的那根 K，就是波段低點 / 高點")
emaEnable  = input.bool(true, "Ema enable", group=grpS, tooltip="開：收盤突破那根 K 時，收盤也要在 EMA 正確的一側，不然這次不算。關：只看收盤突破")
sigEmaLen  = input.int(8, "Ema number", minval=1, group=grpS)
sigEmaSrc  = input.source(hl2, "Ema source", group=grpS, tooltip="對照原版截圖，hl2 最吻合；也可以改成 close")
confirmBar = input.bool(true, "K 棒收盤才出訊號", group=grpS, tooltip="開：訊號在 K 棒收盤後才出現，之後不會移動或消失")

// ═════════════════ ② 趨勢 ═════════════════
grpT        = "② 趨勢"
trendMethod = input.string("不使用", "趨勢判斷", options=["不使用", "價格 vs EMA", "EMA 快慢線", "EMA 斜率", "更高週期 EMA", "共識 K 棒"], group=grpT,
     tooltip="價格 vs EMA：收盤在 EMA 之上為多。EMA 快慢線：快線在慢線之上為多。EMA 斜率：EMA 比 N 根前高為多。更高週期 EMA：更高週期已收盤的 EMA 往上為多。共識 K 棒：K 棒變綠為多、變紅為空")
trendLen    = input.int(200, "EMA 長度", minval=1, group=grpT, tooltip="價格 vs EMA、EMA 斜率、更高週期 EMA 用這個長度")
trendFast   = input.int(50, "快線", minval=1, group=grpT, inline="tfs")
trendSlow   = input.int(200, "慢線", minval=1, group=grpT, inline="tfs")
slopeBars   = input.int(10, "斜率回看根數", minval=1, group=grpT)
htfTf       = input.timeframe("60", "更高週期", group=grpT)
counterMode = input.string("全部顯示", "逆勢訊號", options=["全部顯示", "淡化", "隱藏"], group=grpT,
     tooltip="跟趨勢方向相反的訊號要怎麼顯示。回測統計不受影響，一律全部計算並分成順勢 / 逆勢")

// ═════════════════ ③ 訊號外觀 ═════════════════
grpA        = "③ 訊號外觀"
showBuy     = input.bool(true, "顯示買訊", group=grpA, inline="bs")
showSell    = input.bool(true, "顯示賣訊", group=grpA, inline="bs")
sigStyle    = input.string("標籤", "樣式", options=["標籤", "三角形"], group=grpA, inline="st")
sigSize     = input.string("小", "大小", options=["小", "中", "大"], group=grpA, inline="st")
buyColor    = input.color(#39FF3C, "買訊", group=grpA, inline="sc")
sellColor   = input.color(#F23645, "賣訊", group=grpA, inline="sc")
fadeTransp  = input.int(75, "淡化透明度", minval=0, maxval=100, group=grpA)
sigBg       = input.bool(false, "Color background", group=grpA, inline="sbg", tooltip="出訊號的 K 棒加背景色")
sigBgTransp = input.int(85, "透明度", minval=0, maxval=100, group=grpA, inline="sbg")

// ═════════════════ ④ 線條 ═════════════════
grpL          = "④ 線條"
showInterm    = input.bool(true, "Interm 支撐 / 壓力", group=grpL, inline="im")
intermStyleS  = input.string("線", "", options=["線", "階梯"], group=grpL, inline="im")
intermWidth   = input.int(1, "粗細", minval=1, maxval=4, group=grpL, inline="im")
intermLen     = input.int(100, "　回看根數", minval=2, group=grpL, tooltip="中期支撐壓力 = 這段期間的最高 / 最低")
showNearT     = input.bool(true, "Near T 支撐 / 壓力", group=grpL, inline="nt")
nearStyleS    = input.string("十字", "", options=["十字", "圓點", "線"], group=grpL, inline="nt")
nearWidth     = input.int(1, "粗細", minval=1, maxval=4, group=grpL, inline="nt")
nearLen       = input.int(25, "　回看根數", minval=2, group=grpL, tooltip="短期支撐壓力 = 這段期間的最高 / 最低")
colUp         = input.color(#39FF3C, "多方", group=grpL, inline="col")
colDn         = input.color(#F23645, "空方", group=grpL, inline="col")
colNt         = input.color(#787B86, "中性", group=grpL, inline="col")
showSigEma    = input.bool(false, "訊號 EMA 線", group=grpL, inline="se")
sigEmaColor   = input.color(color.orange, "", group=grpL, inline="se")
showTrendLine = input.bool(false, "趨勢 EMA 線", group=grpL, inline="tl")
trendLnColor  = input.color(#2962FF, "", group=grpL, inline="tl")
showTrendBg   = input.bool(false, "趨勢背景色", group=grpL, inline="tb")
trendBgTransp = input.int(92, "透明度", minval=0, maxval=100, group=grpL, inline="tb")
showCloud     = input.bool(false, "Show Cloud", group=grpL, inline="cl", tooltip="MACD 快慢均線之間的雲")
cloudTransp   = input.int(85, "透明度", minval=0, maxval=100, group=grpL, inline="cl")
showBO        = input.bool(false, "突破 / 跌破 Interm 標記", group=grpL)

// ═════════════════ ⑤ K 棒與表格 ═════════════════
grpK      = "⑤ K 棒與表格"
coloredOn = input.bool(true, "Colored Candles On", group=grpK)
showTable = input.bool(true, "共識 / 趨勢狀態", group=grpK, inline="t1")
tablePos  = input.string("右上", "", options=["右上", "右下", "左上", "左下", "中上", "中下"], group=grpK, inline="t1")
showStats = input.bool(true, "回測統計", group=grpK, inline="t2")
statsPos  = input.string("右下", "", options=["右上", "右下", "左上", "左下", "中上", "中下"], group=grpK, inline="t2")
textColor = input.color(color.black, "Label Text color", group=grpK)
textSizeS = input.string("auto", "Text size", options=["auto", "tiny", "small", "normal", "large"], group=grpK)

// ═════════════════ ⑥ 停損 / 目標線 ═════════════════
grpX       = "⑥ 停損 / 目標線（最新一個訊號）"
showSLTP   = input.bool(true, "顯示", group=grpX, inline="x0")
showSLTPLb = input.bool(true, "價格標籤", group=grpX, inline="x0")
slColor    = input.color(#F23645, "停損", group=grpX, inline="x1")
tpColor    = input.color(#39FF3C, "目標", group=grpX, inline="x1")
sltpStyleS = input.string("虛線", "樣式", options=["實線", "虛線", "點線"], group=grpX, inline="x2")
sltpWidth  = input.int(1, "粗細", minval=1, maxval=4, group=grpX, inline="x2")

// ═════════════════ ⑦ 回測統計設定 ═════════════════
grpB     = "⑦ 回測統計"
targetR  = input.float(1.5, "目標（R 倍數）", minval=0.1, step=0.1, group=grpB,
     tooltip="每個訊號當一筆交易：訊號 K 棒收盤進場；停損放在波段那根 K 的最低（買）/ 最高（賣）；R = 進場價到停損的距離")
maxHold  = input.int(60, "最長持有根數", minval=1, group=grpB, tooltip="停損和目標都沒碰到，第幾根收盤出場")
costPts  = input.float(1.0, "來回成本（點）", minval=0, step=0.25, group=grpB, tooltip="手續費加滑價，每筆交易扣一次")
stopBuf  = input.int(1, "停損緩衝（tick）", minval=0, group=grpB, tooltip="停損放在波段極值再外面幾個 tick")

// ═════════════════ ⑧ 共識 K 棒（原 Breakout alert）═════════════════
grpC       = "⑧ 共識 K 棒"
macdType   = input.string("EMA", "MACD AverageType", options=["EMA", "SMA", "WMA", "WILDERS"], group=grpC)
dmiType    = input.string("WILDERS", "DMI averageType", options=["WILDERS", "EMA", "SMA", "WMA"], group=grpC)
adxType    = input.string("WILDERS", "ADX averageType", options=["WILDERS", "EMA", "SMA", "WMA"], group=grpC)
confFactor = input.int(7, "Confirmation Factor", minval=1, maxval=10, group=grpC, tooltip="10 個指標中至少幾個同向，K 棒和線才變綠／紅，否則灰")

grpP       = "⑨ 共識用的指標參數"
macdFast   = input.int(12, "MACD 快線", minval=1, group=grpP, inline="m")
macdSlow   = input.int(26, "慢線", minval=1, group=grpP, inline="m")
macdSigLen = input.int(9, "訊號線", minval=1, group=grpP, inline="m")
dmiLen     = input.int(14, "DMI 長度", minval=1, group=grpP, inline="d")
adxLen     = input.int(14, "ADX 平滑", minval=1, group=grpP, inline="d")
rsiLen     = input.int(14, "RSI 長度", minval=1, group=grpP)
stochLen   = input.int(14, "Stoch 長度", minval=1, group=grpP)
momLen     = input.int(10, "Momentum 長度", minval=1, group=grpP)
cciLen     = input.int(20, "CCI 長度", minval=1, group=grpP)
emaLen     = input.int(20, "EMA 長度", minval=1, group=grpP)

// ═════════════════ 版面模式 → 實際要畫什麼 ═════════════════
bool custom   = layout == "自訂"
bool full     = layout == "全部顯示"
bool vInterm  = custom ? showInterm  : layout != "只看訊號"
bool vNearT   = custom ? showNearT   : layout != "只看訊號"
bool vCandles = custom ? coloredOn   : layout != "只看訊號"
bool vCloud   = custom ? showCloud   : full
bool vSigEma  = custom ? showSigEma  : full
bool vTrendLn = custom ? showTrendLine : full
bool vTrendBg = custom ? showTrendBg : full
bool vBO      = custom ? showBO      : full
bool vSLTP    = custom ? showSLTP    : full
bool vTable   = custom ? showTable   : layout != "只看訊號"
bool vStats   = custom ? showStats   : full

// ═════════════════ 工具函式 ═════════════════
ma(float src, simple int len, simple string maType) =>
    float s = ta.sma(src, len)
    float e = ta.ema(src, len)
    float w = ta.wma(src, len)
    float r = ta.rma(src, len)
    maType == "SMA" ? s : maType == "EMA" ? e : maType == "WMA" ? w : r

// DMI 可選平均方式（內建 ta.dmi 只有 Wilder）
dirMove(simple int len, simple string maType) =>
    float up      = ta.change(high)
    float down    = -ta.change(low)
    float plusDM  = na(up) ? na : (up > down and up > 0 ? up : 0)
    float minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    float trur    = ma(ta.tr(true), len, maType)
    float plus    = fixnan(100 * ma(plusDM, len, maType) / trur)
    float minus   = fixnan(100 * ma(minusDM, len, maType) / trur)
    [plus, minus]

vote(bool bull, bool bear) =>
    bull ? 1 : bear ? -1 : 0

posOf(string s) =>
    switch s
        "右上" => position.top_right
        "右下" => position.bottom_right
        "左上" => position.top_left
        "左下" => position.bottom_left
        "中上" => position.top_center
        => position.bottom_center

// 一筆交易在這根 K 的結果：0 還沒出場、1 到目標、-1 停損、2 到期。停損和目標同一根都碰到時算停損
evalTrade(int dirn, float entry, float stop, float tgt, int age) =>
    bool hitStop = dirn == 1 ? low <= stop : high >= stop
    bool hitTgt  = dirn == 1 ? high >= tgt : low <= tgt
    int res = hitStop ? -1 : hitTgt ? 1 : age >= maxHold ? 2 : 0
    float px = res == -1 ? stop : res == 1 ? tgt : close
    [res, px]

fmtSigned(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "0.00")

// ═════════════════ 共識：10 個指標投票 ═════════════════
float fastMA   = ma(close, macdFast, macdType)
float slowMA   = ma(close, macdSlow, macdType)
float macdLine = fastMA - slowMA
float macdSig  = ma(macdLine, macdSigLen, macdType)
float macdHist = macdLine - macdSig

[diPlus, diMinus] = dirMove(dmiLen, dmiType)
float diSum = diPlus + diMinus
float adx   = ma(100 * math.abs(diPlus - diMinus) / (diSum == 0 ? 1 : diSum), adxLen, adxType)

float rsi  = ta.rsi(close, rsiLen)
float k    = ta.sma(ta.stoch(close, high, low, stochLen), 3)
float d    = ta.sma(k, 3)
float mom  = ta.mom(close, momLen)
float cci  = ta.cci(close, cciLen)
float emaC = ta.ema(close, emaLen)
bool adxUp = adx > adx[1]

int[] votes = array.from(
     vote(macdLine > macdSig, macdLine < macdSig),
     vote(macdHist > macdHist[1], macdHist < macdHist[1]),
     vote(rsi > 50, rsi < 50),
     vote(k > d, k < d),
     vote(k > 50, k < 50),
     vote(diPlus > diMinus, diPlus < diMinus),
     vote(adxUp and diPlus > diMinus, adxUp and diPlus < diMinus),
     vote(mom > 0, mom < 0),
     vote(cci > 0, cci < 0),
     vote(close > emaC, close < emaC))

int bullCnt = 0
int bearCnt = 0
for v in votes
    bullCnt += v > 0 ? 1 : 0
    bearCnt += v < 0 ? 1 : 0

bool isBull = bullCnt >= confFactor and bullCnt > bearCnt
bool isBear = bearCnt >= confFactor and bearCnt > bullCnt
color stateCol = isBull ? colUp : isBear ? colDn : colNt

barcolor(vCandles ? stateCol : na, title="共識 K 棒顏色")

// 保險：看不見的 K 棒高 / 低點。萬一指標在圖上被放到自己的刻度，它的自動縮放範圍也會跟 K 棒一樣，箭頭不會亂飄
plot(high, "錨點 高", color=color.new(color.gray, 100), editable=false, display=display.pane)
plot(low, "錨點 低", color=color.new(color.gray, 100), editable=false, display=display.pane)

// ═════════════════ 支撐壓力線 ═════════════════
float intermRes = ta.highest(high, intermLen)
float intermSup = ta.lowest(low, intermLen)
float nearRes   = ta.highest(high, nearLen)
float nearSup   = ta.lowest(low, nearLen)

intermPlotStyle = intermStyleS == "階梯" ? plot.style_stepline : plot.style_line
nearPlotStyle   = nearStyleS == "十字" ? plot.style_cross : nearStyleS == "圓點" ? plot.style_circles : plot.style_linebr

plot(vInterm ? intermRes : na, "Interm Resistance", color=stateCol, linewidth=intermWidth, style=intermPlotStyle)
plot(vInterm ? intermSup : na, "Interm Support", color=stateCol, linewidth=intermWidth, style=intermPlotStyle)
plot(vNearT ? nearRes : na, "Near T Resistance", color=stateCol, linewidth=nearWidth, style=nearPlotStyle)
plot(vNearT ? nearSup : na, "Near T Support", color=stateCol, linewidth=nearWidth, style=nearPlotStyle)

pFast = plot(vCloud ? fastMA : na, "Cloud Fast", color=color.new(colNt, 100), editable=false)
pSlow = plot(vCloud ? slowMA : na, "Cloud Slow", color=color.new(colNt, 100), editable=false)
fill(pFast, pSlow, color=fastMA > slowMA ? color.new(colUp, cloudTransp) : color.new(colDn, cloudTransp), title="Cloud")

// ═════════════════ 趨勢 ═════════════════
float tEma  = ta.ema(close, trendLen)
float tFast = ta.ema(close, trendFast)
float tSlow = ta.ema(close, trendSlow)
// 更高週期只用已收盤的值（[1]、[2] 搭配 lookahead_on），不會重繪
[htfE1, htfE2] = request.security(syminfo.tickerid, htfTf, [ta.ema(close, trendLen)[1], ta.ema(close, trendLen)[2]], lookahead=barmerge.lookahead_on)

int trendDir = switch trendMethod
    "價格 vs EMA"  => close > tEma ? 1 : close < tEma ? -1 : 0
    "EMA 快慢線"   => tFast > tSlow ? 1 : tFast < tSlow ? -1 : 0
    "EMA 斜率"     => tEma > tEma[slopeBars] ? 1 : tEma < tEma[slopeBars] ? -1 : 0
    "更高週期 EMA" => htfE1 > htfE2 ? 1 : htfE1 < htfE2 ? -1 : 0
    "共識 K 棒"    => isBull ? 1 : isBear ? -1 : 0
    => 0

bool useTrend = trendMethod != "不使用"
float trendLine1 = trendMethod == "EMA 快慢線" ? tFast : trendMethod == "更高週期 EMA" ? htfE1 : (trendMethod == "價格 vs EMA" or trendMethod == "EMA 斜率") ? tEma : na
float trendLine2 = trendMethod == "EMA 快慢線" ? tSlow : na
plot(vTrendLn ? trendLine1 : na, "趨勢 EMA", color=trendLnColor, linewidth=2)
plot(vTrendLn ? trendLine2 : na, "趨勢 EMA（慢）", color=color.new(trendLnColor, 40), linewidth=2)
bgcolor(vTrendBg and useTrend ? (trendDir == 1 ? color.new(colUp, trendBgTransp) : trendDir == -1 ? color.new(colDn, trendBgTransp) : na) : na, title="趨勢背景")

// ═════════════════ 買賣訊號 ═════════════════
// 1. 創前「階段」根新低的那根 K = 波段低點，記下它的最高價和最低價（賣訊反過來）
// 2. 之後第一根收盤站上那根的最高價 = 觸發；同時收盤在 EMA 之上才出買訊
// 3. 不管有沒有出訊號，觸發一次就用掉，要等下一個新低才會再等訊號
bool newLow  = low < ta.lowest(low, stageLen)[1]
bool newHigh = high > ta.highest(high, stageLen)[1]

var float refHigh = na    // 波段低點那根 K 的最高價（買訊觸發價）
var float swLow   = na    // 波段低點那根 K 的最低價（買訊停損）
var float refLow  = na    // 波段高點那根 K 的最低價（賣訊觸發價）
var float swHigh  = na    // 波段高點那根 K 的最高價（賣訊停損）
var bool  armBuy  = false
var bool  armSell = false

float sigEma  = ta.ema(sigEmaSrc, sigEmaLen)
bool trigBuy  = not newLow and armBuy and close > refHigh
bool trigSell = not newHigh and armSell and close < refLow
float buyStop  = swLow       // 觸發當根沒有創新低，所以這裡還是那根波段 K 的值
float sellStop = swHigh

if newLow
    refHigh := high
    swLow   := low
    armBuy  := true
else if trigBuy
    armBuy := false
if newHigh
    refLow  := low
    swHigh  := high
    armSell := true
else if trigSell
    armSell := false

bool buySetup  = trigBuy and (not emaEnable or close > sigEma)
bool sellSetup = trigSell and (not emaEnable or close < sigEma)
bool barOk     = not confirmBar or barstate.isconfirmed
bool buySig    = buySetup and barOk
bool sellSig   = sellSetup and barOk

bool withB = not useTrend or trendDir == 1
bool withS = not useTrend or trendDir == -1
bool drawBuy  = showBuy and buySig and (counterMode != "隱藏" or withB)
bool drawSell = showSell and sellSig and (counterMode != "隱藏" or withS)
color buyCol  = counterMode == "淡化" and not withB ? color.new(buyColor, fadeTransp) : buyColor
color sellCol = counterMode == "淡化" and not withS ? color.new(sellColor, fadeTransp) : sellColor

bool stLabel = sigStyle == "標籤"
bool szS = sigSize == "小"
bool szM = sigSize == "中"
bool szL = sigSize == "大"
plotshape(drawBuy and stLabel and szS, "買 標籤小", shape.labelup, location.belowbar, color=buyCol, size=size.small, editable=false)
plotshape(drawBuy and stLabel and szM, "買 標籤中", shape.labelup, location.belowbar, color=buyCol, size=size.normal, editable=false)
plotshape(drawBuy and stLabel and szL, "買 標籤大", shape.labelup, location.belowbar, color=buyCol, size=size.large, editable=false)
plotshape(drawBuy and not stLabel and szS, "買 三角小", shape.triangleup, location.belowbar, color=buyCol, size=size.small, editable=false)
plotshape(drawBuy and not stLabel and szM, "買 三角中", shape.triangleup, location.belowbar, color=buyCol, size=size.normal, editable=false)
plotshape(drawBuy and not stLabel and szL, "買 三角大", shape.triangleup, location.belowbar, color=buyCol, size=size.large, editable=false)
plotshape(drawSell and stLabel and szS, "賣 標籤小", shape.labeldown, location.abovebar, color=sellCol, size=size.small, editable=false)
plotshape(drawSell and stLabel and szM, "賣 標籤中", shape.labeldown, location.abovebar, color=sellCol, size=size.normal, editable=false)
plotshape(drawSell and stLabel and szL, "賣 標籤大", shape.labeldown, location.abovebar, color=sellCol, size=size.large, editable=false)
plotshape(drawSell and not stLabel and szS, "賣 三角小", shape.triangledown, location.abovebar, color=sellCol, size=size.small, editable=false)
plotshape(drawSell and not stLabel and szM, "賣 三角中", shape.triangledown, location.abovebar, color=sellCol, size=size.normal, editable=false)
plotshape(drawSell and not stLabel and szL, "賣 三角大", shape.triangledown, location.abovebar, color=sellCol, size=size.large, editable=false)

plot(vSigEma ? sigEma : na, "訊號 EMA", color=sigEmaColor)
bgcolor(sigBg and drawBuy ? color.new(buyColor, sigBgTransp) : sigBg and drawSell ? color.new(sellColor, sigBgTransp) : na, title="訊號背景")

// 原指標名稱的「Breakout」：收盤站上 / 跌破前一根的 Interm 線
bool brkUp = close > intermRes[1]
bool brkDn = close < intermSup[1]
plotshape(vBO and brkUp and not brkUp[1], "Breakout Up", shape.triangleup, location.belowbar, color=colUp, size=size.tiny)
plotshape(vBO and brkDn and not brkDn[1], "Breakout Down", shape.triangledown, location.abovebar, color=colDn, size=size.tiny)

// ═════════════════ 回測統計 ═════════════════
// 每個訊號都當一筆獨立交易（可以同時有好幾筆），統計分成 0 全部、1 順勢、2 逆勢
var array<int>   tDir   = array.new_int()
var array<float> tEntry = array.new_float()
var array<float> tStop  = array.new_float()
var array<float> tTgt   = array.new_float()
var array<int>   tBar   = array.new_int()
var array<int>   tGrp   = array.new_int()
var array<float> sN  = array.new_float(3, 0.0)
var array<float> sW  = array.new_float(3, 0.0)
var array<float> sR  = array.new_float(3, 0.0)
var array<float> sGW = array.new_float(3, 0.0)
var array<float> sGL = array.new_float(3, 0.0)
var array<float> sP  = array.new_float(3, 0.0)

float buf = stopBuf * syminfo.mintick

if barstate.isconfirmed
    int nOpen = array.size(tDir)
    if nOpen > 0
        for i = nOpen - 1 to 0
            int dir  = array.get(tDir, i)
            float en = array.get(tEntry, i)
            float st = array.get(tStop, i)
            [res, px] = evalTrade(dir, en, st, array.get(tTgt, i), bar_index - array.get(tBar, i))
            if res != 0
                float pts = (px - en) * dir - costPts
                float r   = pts / ((en - st) * dir)
                int g = array.get(tGrp, i)
                int nGroups = g > 0 ? 2 : 1
                for j = 0 to nGroups - 1
                    int gi = j == 0 ? 0 : g
                    array.set(sN, gi, array.get(sN, gi) + 1)
                    array.set(sR, gi, array.get(sR, gi) + r)
                    array.set(sP, gi, array.get(sP, gi) + pts)
                    if r > 0
                        array.set(sW, gi, array.get(sW, gi) + 1)
                        array.set(sGW, gi, array.get(sGW, gi) + r)
                    else
                        array.set(sGL, gi, array.get(sGL, gi) - r)
                array.remove(tDir, i)
                array.remove(tEntry, i)
                array.remove(tStop, i)
                array.remove(tTgt, i)
                array.remove(tBar, i)
                array.remove(tGrp, i)
    if buySetup and close - (buyStop - buf) > 0
        float st = buyStop - buf
        array.push(tDir, 1)
        array.push(tEntry, close)
        array.push(tStop, st)
        array.push(tTgt, close + targetR * (close - st))
        array.push(tBar, bar_index)
        array.push(tGrp, useTrend ? (trendDir == 1 ? 1 : 2) : 0)
    if sellSetup and (sellStop + buf) - close > 0
        float st = sellStop + buf
        array.push(tDir, -1)
        array.push(tEntry, close)
        array.push(tStop, st)
        array.push(tTgt, close - targetR * (st - close))
        array.push(tBar, bar_index)
        array.push(tGrp, useTrend ? (trendDir == -1 ? 1 : 2) : 0)

// ═════════════════ 停損 / 目標線（最新一個訊號）═════════════════
var line  slLn = na
var line  tpLn = na
var label slLb = na
var label tpLb = na
var int   lnDir   = 0
var float lnEntry = na
var float lnStop  = na
var float lnTgt   = na
var int   lnBar   = na
var bool  lnLive  = false
lineStyle = sltpStyleS == "實線" ? line.style_solid : sltpStyleS == "點線" ? line.style_dotted : line.style_dashed

if barstate.isconfirmed
    if lnLive
        [res, px] = evalTrade(lnDir, lnEntry, lnStop, lnTgt, bar_index - lnBar)
        line.set_x2(slLn, bar_index)
        line.set_x2(tpLn, bar_index)
        if not na(slLb)
            label.set_x(slLb, bar_index)
            label.set_x(tpLb, bar_index)
        if res != 0
            lnLive := false
    if vSLTP and (drawBuy or drawSell)
        line.delete(slLn)
        line.delete(tpLn)
        label.delete(slLb)
        label.delete(tpLb)
        lnDir   := drawBuy ? 1 : -1
        lnEntry := close
        lnStop  := drawBuy ? buyStop - buf : sellStop + buf
        lnTgt   := lnEntry + targetR * (lnEntry - lnStop)
        lnBar   := bar_index
        lnLive  := true
        slLn := line.new(bar_index, lnStop, bar_index, lnStop, color=slColor, style=lineStyle, width=sltpWidth)
        tpLn := line.new(bar_index, lnTgt, bar_index, lnTgt, color=tpColor, style=lineStyle, width=sltpWidth)
        if showSLTPLb
            slLb := label.new(bar_index, lnStop, "停損 " + str.tostring(lnStop, format.mintick), style=label.style_label_left, color=color.new(slColor, 80), textcolor=textColor, size=size.small)
            tpLb := label.new(bar_index, lnTgt, "目標 " + str.tostring(lnTgt, format.mintick), style=label.style_label_left, color=color.new(tpColor, 80), textcolor=textColor, size=size.small)

// ═════════════════ 表格 ═════════════════
string tsize = switch textSizeS
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.auto

var table tbState = table.new(posOf(tablePos), 1, 2)
var table tbStats = table.new(posOf(statsPos), 6, 5, border_width=1, border_color=color.new(colNt, 60), frame_width=1, frame_color=color.new(colNt, 40))
if barstate.isfirst
    table.merge_cells(tbStats, 0, 0, 5, 0)    // 標題列只合併一次，即時 K 棒每個 tick 重算時不會重複合併

if barstate.islast
    if vTable
        string state = isBull ? "多方" : isBear ? "空方" : "中性"
        table.cell(tbState, 0, 0, "共識 " + state + "  " + str.tostring(bullCnt) + "↑ / " + str.tostring(bearCnt) + "↓  門檻 " + str.tostring(confFactor),
             text_color=textColor, text_size=tsize, bgcolor=color.new(stateCol, 70))
        if useTrend
            string tTxt = trendDir == 1 ? "↑ 多" : trendDir == -1 ? "↓ 空" : "— 盤整"
            color tCol = trendDir == 1 ? colUp : trendDir == -1 ? colDn : colNt
            table.cell(tbState, 0, 1, "趨勢（" + trendMethod + "）" + tTxt, text_color=textColor, text_size=tsize, bgcolor=color.new(tCol, 70))
    if vStats
        table.cell(tbStats, 0, 0, "回測 目標" + str.tostring(targetR, "0.0") + "R・持有" + str.tostring(maxHold) + "根・成本" + str.tostring(costPts, "0.##") + "點",
             text_color=textColor, text_size=tsize, bgcolor=color.new(colNt, 75))
        hdr = array.from("", "筆數", "勝率", "平均 R", "獲利因子", "淨點數")
        for c = 0 to 5
            table.cell(tbStats, c, 1, array.get(hdr, c), text_color=textColor, text_size=tsize, bgcolor=color.new(colNt, 85))
        names = array.from("全部", "順勢", "逆勢")
        int rows = useTrend ? 3 : 1
        for g = 0 to rows - 1
            float n = array.get(sN, g)
            float gl = array.get(sGL, g)
            float avgR = n > 0 ? array.get(sR, g) / n : 0.0
            color rowCol = n == 0 ? color.new(colNt, 90) : avgR > 0 ? color.new(colUp, 80) : color.new(colDn, 80)
            table.cell(tbStats, 0, g + 2, array.get(names, g), text_color=textColor, text_size=tsize, bgcolor=rowCol)
            table.cell(tbStats, 1, g + 2, str.tostring(n, "0"), text_color=textColor, text_size=tsize, bgcolor=rowCol)
            table.cell(tbStats, 2, g + 2, n > 0 ? str.tostring(100 * array.get(sW, g) / n, "0.0") + "%" : "-", text_color=textColor, text_size=tsize, bgcolor=rowCol)
            table.cell(tbStats, 3, g + 2, n > 0 ? fmtSigned(avgR) : "-", text_color=textColor, text_size=tsize, bgcolor=rowCol)
            table.cell(tbStats, 4, g + 2, n == 0 ? "-" : gl > 0 ? str.tostring(array.get(sGW, g) / gl, "0.00") : "∞", text_color=textColor, text_size=tsize, bgcolor=rowCol)
            table.cell(tbStats, 5, g + 2, n > 0 ? fmtSigned(array.get(sP, g)) : "-", text_color=textColor, text_size=tsize, bgcolor=rowCol)

// ═════════════════ 警示 ═════════════════
alertcondition(buySig, "買進訊號", "{{ticker}} 收盤站上波段低點那根 K 的高點，買進訊號 @ {{close}}")
alertcondition(sellSig, "賣出訊號", "{{ticker}} 收盤跌破波段高點那根 K 的低點，賣出訊號 @ {{close}}")
alertcondition(buySig and withB, "順勢買進訊號", "{{ticker}} 順勢買進訊號 @ {{close}}")
alertcondition(sellSig and withS, "順勢賣出訊號", "{{ticker}} 順勢賣出訊號 @ {{close}}")
alertcondition(brkUp and not brkUp[1], "突破 Interm 壓力", "{{ticker}} 收盤突破中期壓力 @ {{close}}")
alertcondition(brkDn and not brkDn[1], "跌破 Interm 支撐", "{{ticker}} 收盤跌破中期支撐 @ {{close}}")
