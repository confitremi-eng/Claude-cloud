//@version=6
// Remi Superb v3：自動辨識商品和週期，套用回測過的做法，只發「可交易的 Buy」和「可交易的 Sell」兩個快訊
// 狀態：大致完成（2026-10-19），之後只做小修
//   NQ / MNQ 2 分 K：趨勢訊號（趨勢已持續 0–180 分）+ MIX 區間突破，目標 3R              回測每年 +166R，回撤 12.5R
//   NQ / MNQ 3 分 K：趨勢訊號（趨勢已持續 90–120 分），目標 1R                           勝率 74%，每年 +20R，回撤 2R
//   NQ / MNQ 5 分 K：趨勢訊號（趨勢已持續 0–180 分）+ MIX 區間突破，目標 2R              每年 +90R，回撤 11R
//   QQQ 1 分 K：ETF 設定 (35, 0, 8, 1)、Trend Judge 門檻 0.5、離慢線 ≤ 7 ATR、NQ 2 分 K 不反向，目標 3R   每年 +66R，回撤 17R
//   NQ / MNQ 1 分 K 只開美股盤（RTH，代替 QQQ）：同 QQQ 的做法，門檻用 NQ 20 點（回測就是用這種圖代替 QQQ）
//   SPY 1 分 K：ETF 設定 (35, 0, 8, 1)、Trend Judge 門檻 0.8、離慢線 ≤ 7 ATR，目標 3R      每年 +67R，回撤 21R
//   TXF / MXF 2、3 分 K：趨勢訊號（趨勢已持續 60–120 分），目標 3R                        邊緣：每年 +10R / +5R（成本 2 點）
//   ES / MES：回測每種做法都虧，預設不發訊號
// 趨勢訊號 = 原版買賣訊號 + Trend Judge 有趨勢 + 1 小時 EMA20 同向 + 停損 ≥ 1 ATR + 離 15 秒 EMA1130 不太遠 + 避開數據 / 開收盤 / Globex / FOMC
//   訊號 K 收盤進場，停損在訊號 K 和前一根的極值
// MIX 區間突破（只有 NQ 2、5 分 K）：Trend Judge 連續 MIX 60 分鐘 → 區間；形成後 60 分鐘內第一次突破 10% 就在突破價進場，停損在中線
//   美東 16:00–20:00（收盤後）碰到突破價就不做，這個區間作廢（預設開，可關）
//   選項「MIX 等收線才進場」：等 K 棒收在突破價外才在收盤進場，目標 2R（預設關＝碰到突破價就進場）
// 一次一筆：指標自己記一筆虛擬持倉，碰到停損 / 目標、持有 60 根 K、美東 17:00 休市前（NQ / ES）或資料中斷才算出場
// 回測：NQ / ES / TXF 用各自的 1 分 K；SPY / QQQ 用 ES / NQ 只留美股盤的 K 棒代替。說明見 indicators/remi_superb.md
// 訊號參數：v3 的交易訊號預設依商品自動（回測過），可以改成自訂；橙黃色原版小三角另有自己的參數（預設 35, 0, 8, 1）
// Trend Judge 用 1 分 K 收盤推算（同回測，不需要秒級資料）；沒有 1 分資料的舊 K 棒自動改用圖表 K 棒推算
// GEX（預設關）：手動輸入 QQQ 的 gamma flip，表格顯示現在買 / 賣是「朝 flip 走」還是「離開 flip」，只顯示、不擋訊號
// GEX setup（預設關，只有 NQ RTH 1 分 K）：原版 (35, 0, 8, 1) + Trend Judge 順勢 + 朝 QQQ gamma flip 走，目標 3R；記號 🧲
//   另外標記、另外兩個快訊、自己一次一筆，不影響上面 v3 的訊號和虛擬持倉；台灣時間 00:00–01:05 不發（可改、可關）
indicator("Remi Superb v3", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ═════════════════ 商品設定 ═════════════════
grpP      = "商品設定"
profSel   = input.string("自動", "商品", options=["自動", "NQ", "NQ RTH（代替 QQQ）", "ES", "TXF", "QQQ", "SPY"], group=grpP, tooltip="自動：依圖上的商品選設定（NQ / MNQ、ES / MES、TXF / MXF / TMF、QQQ、SPY）。NQ / MNQ 圖如果只開美股盤（RTH：最近 1500 根 K 都在美東 09:30–16:15 之內），自動改用「NQ RTH（代替 QQQ）」：同 QQQ 的做法，建議 1 分 K。也可以手動指定")
otherTf   = input.bool(false, "不是建議週期也發訊號", group=grpP, tooltip="建議週期：NQ 是 2、3 或 5 分 K，TXF 是 2 或 3 分 K，SPY、QQQ、NQ RTH 是 1 分 K。關閉時，其他週期只顯示表格、不發訊號；打開的話用最接近的設定發（沒有回測過）")
qNqOn     = input.bool(true, "QQQ / NQ RTH：NQ 2 分 K 不反向", group=grpP, inline="qnq")
nqSym     = input.symbol("CME_MINI:NQ1!", "", group=grpP, inline="qnq", tooltip="只影響 QQQ 和 NQ RTH：上一根已收完的 NQ 2 分 K（固定讀 24 小時盤），Trend Judge 跟訊號反向（買訊時是 DOWN / 強Down，賣訊時是 UP / 強Up）就不做，MIX 照做。回測：NQ 2m 反向時 QQQ 訊號是虧的（3R −0.05R）；去掉後每年一樣 +66R，回撤 24R → 17R。讀不到 NQ 資料時不擋")
esOn      = input.bool(false, "ES 也發訊號（回測是虧的）", group=grpP, tooltip="ES / MES 2、3 分 K 一年回測，趨勢訊號和 MIX 突破每一種都虧，所以預設不發。打開會用 NQ 2 分 K 的做法（門檻 4、不做 MIX）")

// ═════════════════ 交易規則 ═════════════════
grpR      = "交易規則（各商品共用）"
holdBars  = input.int(60, "最多持有幾根 K", minval=1, group=grpR, tooltip="停損和目標都沒碰到，持有這麼多根 K 後收盤出場（回測都是 60 根）")
onlyOne   = input.bool(true, "一次一筆（持倉中不發新訊號）", group=grpR, tooltip="指標自己記一筆虛擬持倉：要等碰到停損、目標、持有時間到、休市前或資料中斷出場，才會發下一個訊號。回測都是一次一筆")
flatHalt  = input.bool(true, "NQ / ES 在美東 17:00 休市前出場", group=grpR, tooltip="虛擬持倉在美東 17:00 收盤那根 K 出場。TXF、SPY、QQQ 在收盤後的資料中斷自動出場")
friCut    = input.bool(true, "週五美股盤：台灣時間週六", group=grpR, inline="fri")
friCutH   = input.int(2, "", minval=0, maxval=6, group=grpR, inline="fri")
friCutM   = input.int(0, "點　分以後不發新訊號", minval=0, maxval=59, group=grpR, inline="fri", tooltip="週五晚上的美股盤，到台灣時間週六這個時間以後就不發新訊號（趨勢訊號和 MIX 突破都一樣），已經在持倉中的照常出場。預設 02:00＝美東週五 14:00（夏令）/ 13:00（冬令）。所有商品都適用。NQ 2 分 K 一年回測：拿掉 9 個訊號，每年 +162R → +159R，回撤不變")
h1Len     = input.int(20, "1 小時 EMA 長度", minval=1, group=grpR, tooltip="看上一根已收完的 1 小時 K：買要收盤在 1 小時 EMA 之上，賣要在之下")
riskMult  = input.float(1.0, "停損至少幾個 ATR", minval=0, step=0.1, group=grpR, inline="rk")
atrLen    = input.int(14, "ATR 長度", minval=1, group=grpR, inline="rk", tooltip="停損 = 訊號 K 和前一根的最低點（買）/ 最高點（賣）。停損距離小於「倍數 × 上一根的 ATR」就不做")
avoidEvt  = input.bool(true, "避開數據、開收盤、Globex 時段", group=grpR, tooltip="美東時間，看 K 棒收盤時間：平日 08:28–09:00、09:58–10:15；每天 09:30–10:00、15:45–16:15、16:45–17:00、18:00–18:30；FOMC 日 13:58–15:00。所有商品都一樣（回測也是）")
mixPmOff  = input.bool(true, "MIX 突破不做美東 16–20（收盤後）", group=grpR, tooltip="只影響 NQ 2、5 分 K 的 MIX 突破：K 棒收盤時間在美東 16:00–20:00（台灣時間夏令 04:00–08:00、冬令 05:00–09:00）碰到突破價就不做，這個區間作廢（跟事件時段一樣）。趨勢訊號照常。回測一年：2 分 K 每年 +162R → +168R、回撤 16R → 12.5R；5 分 K +82R → +94R、回撤 14R → 11R，前後半年都一樣")
mixClose  = input.bool(false, "MIX 突破等收線才進場（目標 2R）", group=grpR, tooltip="預設關：價格碰到突破價就進場（掛停損單），目標同週期（2 分 K 3R、5 分 K 2R）。打開：要等 K 棒收在突破價外，才在那根收盤進場，目標 2R，停損一樣在中線；只碰到、沒收出去不算，區間繼續有效。回測一年（v3 預設規則，一次一筆）：2 分 K 每年 +166R → +146R、回撤 12.5R → 12.6R；5 分 K +90R → +83R、回撤 10.7R → 13.6R。單獨看 MIX 時等收線的回撤比較小，放進 v3 後就沒有了")
fomcDates = input.string("2025-10-29,2025-12-10,2026-01-28,2026-03-18,2026-04-29,2026-06-17,2026-07-29,2026-09-16,2026-10-28,2026-12-09", "FOMC 日期", group=grpR, tooltip="利率決議公布日（美東），逗號分開。每年照 Fed 公布的日程更新")

// ═════════════════ GEX（手動輸入）═════════════════
grpG      = "GEX（手動輸入的 QQQ gamma flip）"
gexOn     = input.bool(false, "顯示 QQQ gamma flip 方向", group=grpG, tooltip="打開後，表格多一列「Flip」：QQQ 現價在 gamma flip 下面時，買是「朝 flip 走」、賣是「離開 flip」；在上面時相反。回測（ZeroGEX 2026-06-29 .. 10-14，76 天，QQQ 1 分 K）：順勢訊號朝 flip 走的 3R 每筆約 +0.75R，離開 flip 的約 0 或虧；v3 在 QQQ 的獲利幾乎都來自朝 flip 走的訊號。樣本小，先只顯示、不擋訊號")
gexFlip   = input.float(0.0, "QQQ gamma flip", minval=0, step=0.01, group=grpG, tooltip="從 ZeroGEX 抄 QQQ 的 gamma flip 價位（QQQ 價格，不是 NQ）。flip 每天會變、盤中也會移動，要自己更新；0 = 還沒輸入")
qqqSym    = input.symbol("NASDAQ:QQQ", "QQQ 代號", group=grpG, tooltip="不是 QQQ 圖（例如 NQ、NQ RTH）時，用這個代號讀 QQQ 現價來跟 flip 比；美股盤以外的時間是 QQQ 最後的價格")
gexLine   = input.bool(true, "QQQ 圖上畫 flip 線", group=grpG, inline="gl")
gexCol    = input.color(#E040FB, "", group=grpG, inline="gl", tooltip="只有在 QQQ 圖上才畫（flip 是 QQQ 的價格）")
gsOn      = input.bool(false, "NQ RTH：GEX setup 訊號（目標 3R）", group=grpG, tooltip="只在 NQ RTH（NQ 1 分 K、圖表只開美股盤）用：原版訊號（下面的階段、EMA，預設 35、8）出現時，Trend Judge 同向（門檻 20 點），而且朝 QQQ gamma flip 走（QQQ 在 flip 下面時買、在上面時賣，用上面輸入的 flip），就標記並發「GEX Buy / Sell」快訊。訊號 K 收盤進場、停損在訊號 K 和前一根的極值、目標 3R、持有 60 根或美東 16:00 收盤出場，自己一次一筆；週五截止後不發。不影響 v3 原本的訊號和虛擬持倉。回測（NQ 美股盤，2026-07 .. 10-14，ZeroGEX 的 flip，(35, 0, 8, 1)）：77 筆，1R 勝率 66%，3R 每筆 +0.75R，一次一筆合計 +56R、回撤 7R；只有 3 個多月，先小口數追蹤")
gsStage   = input.int(35, "GEX setup　階段", minval=2, group=grpG, inline="gs")
gsEma     = input.int(8, "Ema number", minval=1, group=grpG, inline="gs", tooltip="預設 (35, 0, 8, 1)。回測（NQ RTH，2026-07 .. 10）：階段 35–50 × EMA 5–13 都好，EMA 21 不行；(35, 0, 8, 1) 77 筆、1R 勝率 66%、3R 每筆 +0.75R；(40, 0, 8, 1) 70%、+0.99R；(35, 0, 13, 1) 每筆差不多但訊號少四成")
gsBuyTxt  = input.string("🧲", "GEX setup　買", group=grpG, inline="gm")
gsSellTxt = input.string("🧲", "賣", group=grpG, inline="gm")
gsSize    = input.string("小", "大小", options=["小", "中", "大"], group=grpG, inline="gm", tooltip="GEX setup 自己的記號（價格被 flip 吸過去，所以用磁鐵）：沒有底色，緊貼在訊號那根 K 的低點下方（買）/ 高點上方（賣）。可以換成任何 Emoji 或文字（文字用 flip 線的顏色）")
gsLunch   = input.bool(true, "GEX setup：台灣時間", group=grpG, inline="glt")
gsLH1     = input.int(0, "", minval=0, maxval=23, group=grpG, inline="glt")
gsLM1     = input.int(0, ":", minval=0, maxval=59, group=grpG, inline="glt")
gsLH2     = input.int(1, "到", minval=0, maxval=23, group=grpG, inline="glt")
gsLM2     = input.int(5, ":", minval=0, maxval=59, group=grpG, inline="glt", tooltip="這段時間（看 K 棒收盤的台灣時間，含頭尾）GEX setup 不發 🧲 和快訊；已經在持倉中的照常出場。只影響 GEX setup，v3 原本的訊號不受影響。預設 00:00–01:05 = 美東 12:00–13:05（夏令）/ 11:00–12:05（冬令）。注意回測（2026-07 .. 10-14）：這段的 GEX setup 13 筆、1R 勝率 69%、3R 每筆 +1.07R，反而比其他時間好；去掉後一次一筆 3R +56R → +42R、回撤 6.7R → 4.8R")

// ═════════════════ 外觀 ═════════════════
grpA      = "外觀"
markSize  = input.string("大", "符號大小", options=["小", "中", "大"], group=grpA, inline="ms")
markLines = input.int(0, "離 K 棒（半行）", minval=0, maxval=12, group=grpA, inline="ms", tooltip="符號離 K 棒的距離，每加 1 往外移半個符號高度")
tBuyTxt   = input.string("⏫", "趨勢訊號　買", group=grpA, inline="tb")
tSellTxt  = input.string("⏬", "賣", group=grpA, inline="tb")
mBuyTxt   = input.string("🔼", "MIX 突破　買", group=grpA, inline="mb")
mSellTxt  = input.string("🔽", "賣", group=grpA, inline="mb")
txtCol    = input.color(#FFB300, "文字顏色", group=grpA, tooltip="符號填一般文字時的顏色，Emoji 用它自己的顏色")
showBox   = input.bool(true, "畫出 MIX 區間", group=grpA, inline="bx")
boxCol    = input.color(color.new(#9598A1, 85), "", group=grpA, inline="bx")
boxLnCol  = input.color(#9598A1, "線", group=grpA, inline="bx", tooltip="灰框是用來算區間的那段 MIX，虛線是上下突破價（只有 NQ 2、5 分 K）")
showPos   = input.bool(true, "畫出持倉的停損和目標", group=grpA, inline="ps")
stopCol   = input.color(#F23645, "", group=grpA, inline="ps")
tgtCol    = input.color(#36FE02, "", group=grpA, inline="ps")
showTbl   = input.bool(true, "顯示狀態表格", group=grpA, inline="tbl")
tblStyle  = input.string("精簡", "", options=["精簡", "完整"], group=grpA, inline="tbl")
tblSize   = input.string("極小", "字", options=["極小", "小", "中", "大"], group=grpA, inline="tbl", tooltip="精簡：短標題、一列一行，只顯示這個商品用得到的列（版面小或分割畫面時用）。完整：每列都顯示，附設定說明")
tblPos    = input.string("左下", "表格位置", options=["左下", "右下", "左上", "右上"], group=grpA, tooltip="表格放在圖表的哪個角落")
tblPad    = input.int(2, "表格放上面時，上方留白（列）", minval=0, maxval=6, group=grpA, tooltip="表格放左上或右上時，空幾列避開圖表上方的商品名稱和指標名稱；放下面時不留白")
showRaw   = input.bool(false, "也標出原版買賣訊號（小三角）", group=grpA, inline="raw")
rawCol    = input.color(#FFB300, "", group=grpA, inline="raw", tooltip="沒經過過濾的原版訊號（買在 K 棒下方、賣在上方），預設橙黃色。參數在「訊號參數」的「原版小三角」那一列，跟 v3 的訊號分開算。只是標出來看，不發快訊")

// ═════════════════ 訊號參數 ═════════════════
grpS      = "訊號參數（階段、Ema number、Ema enable）"
sigMode   = input.string("自動（依商品）", "v3 訊號", options=["自動（依商品）", "自訂"], group=grpS, tooltip="v3 交易訊號用的原版訊號參數。自動：NQ / ES / TXF 用 (20, 0, 8, 1)，QQQ / SPY / NQ RTH 用 (35, 0, 8, 1)，都是回測過的。自訂：所有商品都改用下面這一列（沒有回測過）")
v3Stage   = input.int(20, "自訂　階段", minval=2, group=grpS, inline="v3s")
v3Ema     = input.int(8, "Ema number", minval=1, group=grpS, inline="v3s", tooltip="只有選「自訂」時才用。v3 的訊號一定要通過 EMA 確認（Ema enable 固定開），回測都是這樣")
rawStage  = input.int(35, "原版小三角　階段", minval=2, group=grpS, inline="raws")
rawEma    = input.int(8, "Ema number", minval=1, group=grpS, inline="raws")
rawEmaOn  = input.bool(true, "Ema enable", group=grpS, inline="raws", tooltip="橙黃色小三角用的參數，預設 (35, 0, 8, 1)。原版 Remi's Buy/Sell 是 (20, 0, 8, 1)；想看 v3 在這個商品實際用的訊號，就改成跟 v3 一樣（NQ / ES / TXF 是 20、8，QQQ / SPY / NQ RTH 是 35、8）")

// ═════════════════ Trend Judge ═════════════════
grpT      = "Trend Judge（門檻依商品自動）"
tjCalc    = input.string("1 分 K 推算（同回測）", "算法", options=["1 分 K 推算（同回測）", "圖表 K 棒推算"], group=grpT, tooltip="1 分 K 推算：每根 K 裡的每一根 1 分 K 收盤依序更新 5 秒 / 15 秒 EMA（同回測），沒有 1 分資料的舊 K 棒自動改用圖表 K 棒。門檻：NQ 10 / 35、ES 4 / 8、TXF 30 / 60、QQQ 0.5 / 1、SPY 0.8 / 1.6（一般 / 強勢）")
tjEmaLen  = input.int(1130, "EMA 長度", minval=1, group=grpT)
tjFastS   = input.int(5, "快線秒數", minval=1, group=grpT, inline="tjs")
tjSlowS   = input.int(15, "慢線秒數", minval=1, group=grpT, inline="tjs")

// ═════════════════ 商品和週期 → 做法 ═════════════════
string root     = syminfo.root != "" ? syminfo.root : syminfo.ticker
bool   autoTX   = str.contains(root, "TXF") or str.contains(root, "MXF") or str.contains(root, "TMF")
// NQ 圖是不是只開美股盤（RTH）
int  barEtMin  = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
var int lastNight = na
if barEtMin < 570 or barEtMin >= 975
    lastNight := bar_index
// 只看 K 棒（不看 syminfo.session：期貨切 RTH 時 TradingView 回報的時段類型不一定是 regular）：
// 已經有 1500 根 K，而且最近 1500 根都沒有美東 09:30–16:15 以外的 K 棒（24 小時盤的 NQ 每天都有夜盤 K）
bool   chartRth = timeframe.isintraday and bar_index >= 1500 and (na(lastNight) or bar_index - lastNight > 1500)
string autoProf = str.contains(root, "NQ") ? (chartRth ? "NQ RTH" : "NQ") : autoTX ? "TXF" : root == "QQQ" ? "QQQ" : root == "SPY" ? "SPY" : str.contains(root, "ES") ? "ES" : "無"
string prof     = profSel == "自動" ? autoProf : profSel == "NQ RTH（代替 QQQ）" ? "NQ RTH" : profSel
bool   isNqR    = prof == "NQ RTH"
bool   isNQ     = prof == "NQ"
bool   isES     = prof == "ES"
bool   isTX     = prof == "TXF"
bool   isQQ     = prof == "QQQ"
bool   isSP     = prof == "SPY"
bool   isETF    = isQQ or isSP or isNqR       // 美股盤、ETF 設定
bool   isCME    = isNQ or isES
string tfp      = timeframe.period
bool   okTf     = isNQ ? (tfp == "2" or tfp == "3" or tfp == "5") : (isTX or isES) ? (tfp == "2" or tfp == "3") : isETF ? tfp == "1" : false
bool   profOn   = isES ? esOn : (isNQ or isTX or isETF)
bool   active   = profOn and (okTf or otherTf)
bool   nq3      = isNQ and tfp == "3"
bool   nq5      = isNQ and tfp == "5"
bool   sigCust  = sigMode == "自訂"
int    stageUse = sigCust ? v3Stage : isETF ? 35 : 20
int    emaUse   = sigCust ? v3Ema : 8
string sigTxt   = "(" + str.tostring(stageUse) + ", 0, " + str.tostring(emaUse) + ", 1)" + (sigCust ? " 自訂" : "")
float  thU      = isNQ ? 10.0 : isES ? 4.0 : isTX ? 30.0 : isQQ ? 0.5 : isSP ? 0.8 : isNqR ? 20.0 : na
float  stU      = isNQ ? 35.0 : isES ? 8.0 : isTX ? 60.0 : isQQ ? 1.0 : isSP ? 1.6 : isNqR ? 40.0 : na
float  distU    = isETF ? 7.0 : 3.0
bool   useWin   = not isETF
int    winLo    = nq3 ? 90 : isTX ? 60 : 0
int    winHi    = nq3 ? 120 : isTX ? 120 : 180
bool   mixUse   = isNQ and not nq3
float  tgtR     = nq3 ? 1.0 : nq5 ? 2.0 : 3.0
string ruleTxt  = isETF ? "ETF 設定 " + sigTxt + "，" + str.tostring(tgtR) + "R" + ((isQQ or isNqR) and qNqOn ? "，NQ 2m 不反向" : "") + (isNqR ? "（代替 QQQ）" : "") : "趨勢 " + str.tostring(winLo) + "–" + str.tostring(winHi) + " 分" + (mixUse ? " + MIX 突破" + (mixClose ? "（收線 2R）" : "") : "") + "，" + str.tostring(tgtR) + "R，訊號 " + sigTxt
string gradeTxt = not profOn and isES ? "不建議（回測都虧）" : prof == "無" ? "不支援" : not okTf ? "不是建議週期" : isNQ and tfp == "2" ? "主力" : isTX ? "邊緣" : "可做"

// ═════════════════ 原版買賣訊號 ═════════════════
bool newLow  = low < ta.lowest(low, stageUse)[1]
bool newHigh = high > ta.highest(high, stageUse)[1]
var float refHigh = na
var float refLow  = na
var bool  armBuy  = false
var bool  armSell = false
float sigEma  = ta.ema(close, emaUse)
bool trigBuy  = armBuy and close > refHigh
bool trigSell = armSell and close < refLow
if trigBuy
    armBuy := false
else if newLow
    refHigh := high
    armBuy  := true
if trigSell
    armSell := false
else if newHigh
    refLow  := low
    armSell := true
bool buySig  = trigBuy and close > sigEma and barstate.isconfirmed
bool sellSig = trigSell and close < sigEma and barstate.isconfirmed
// 橙黃色小三角：原版買賣訊號，用自己的參數另外算（不影響 v3 的訊號）
bool rNewLow  = low < ta.lowest(low, rawStage)[1]
bool rNewHigh = high > ta.highest(high, rawStage)[1]
var float rRefHigh = na
var float rRefLow  = na
var bool  rArmBuy  = false
var bool  rArmSell = false
float rEma      = ta.ema(close, rawEma)
bool  rTrigBuy  = rArmBuy and close > rRefHigh
bool  rTrigSell = rArmSell and close < rRefLow
if rTrigBuy
    rArmBuy := false
else if rNewLow
    rRefHigh := high
    rArmBuy  := true
if rTrigSell
    rArmSell := false
else if rNewHigh
    rRefLow  := low
    rArmSell := true
bool rawBuy  = rTrigBuy and (not rawEmaOn or close > rEma) and barstate.isconfirmed
bool rawSell = rTrigSell and (not rawEmaOn or close < rEma) and barstate.isconfirmed
plotshape(showRaw and rawBuy, "原版買訊", shape.triangleup, location.belowbar, color=rawCol, size=size.tiny)
plotshape(showRaw and rawSell, "原版賣訊", shape.triangledown, location.abovebar, color=rawCol, size=size.tiny)

// ═════════════════ Trend Judge（1 分 K 推算）═════════════════
float tfSec    = timeframe.in_seconds()
float tjAFast1 = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 60.0 / tjFastS)
float tjASlow1 = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 60.0 / tjSlowS)
float tjAFastB = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), tfSec / tjFastS)
float tjASlowB = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), tfSec / tjSlowS)
tjMinArr = request.security_lower_tf(syminfo.tickerid, "1", close)
var float tjMaFast = na
var float tjMaSlow = na
int  tjMinN = array.size(tjMinArr)
bool tjBy1m = tjCalc == "1 分 K 推算（同回測）" and tjMinN > 0 and tfSec > 60    // 1 分 K 圖直接用圖表 K 棒，結果一樣
if tjBy1m
    for k = 0 to tjMinN - 1
        float mc = array.get(tjMinArr, k)
        if not na(mc)
            tjMaFast := na(tjMaFast) ? mc : tjMaFast + tjAFast1 * (mc - tjMaFast)
            tjMaSlow := na(tjMaSlow) ? mc : tjMaSlow + tjASlow1 * (mc - tjMaSlow)
else
    tjMaFast := na(tjMaFast) ? close : tjMaFast + tjAFastB * (close - tjMaFast)
    tjMaSlow := na(tjMaSlow) ? close : tjMaSlow + tjASlowB * (close - tjMaSlow)
var float tjDiff = na
bool tjNewWin = ta.change(time("2")) != 0
if tjNewWin and not na(tjMaFast) and not na(tjMaSlow)
    tjDiff := tjMaFast - tjMaSlow
int  tjDirI   = na(tjDiff) or na(thU) ? 0 : tjDiff > stU ? 2 : tjDiff > thU ? 1 : tjDiff < -stU ? -2 : tjDiff < -thU ? -1 : 0
bool tjLinked = not na(tjDiff) and not na(thU)

// 趨勢已持續多久：Trend Judge 進入這段趨勢（UP / 強UP 或 DOWN / 強Down）後的分鐘數，MIX 或轉向就歸零
var int trendBars = 0
int trendDir = tjLinked ? (tjDirI > 0 ? 1 : tjDirI < 0 ? -1 : 0) : 0
if trendDir != 0 and trendDir == nz(trendDir[1])
    trendBars += 1
else
    trendBars := trendDir != 0 ? 1 : 0
float trendMin = trendBars * tfSec / 60.0
bool  inWin    = not useWin or (trendMin >= winLo and trendMin < winHi)

// ═════════════════ 時段（美東，看 K 棒收盤時間）═════════════════
int  tClose  = na(time_close) ? time + timeframe.in_seconds() * 1000 : time_close
int  etMin   = hour(tClose, "America/New_York") * 60 + minute(tClose, "America/New_York")
int  etDow   = dayofweek(tClose, "America/New_York")
bool isWkday = etDow >= dayofweek.monday and etDow <= dayofweek.friday
bool isFomc  = str.contains(fomcDates, str.format_time(tClose, "yyyy-MM-dd", "America/New_York"))
bool inEvt   = (isWkday and ((etMin >= 508 and etMin < 540) or (etMin >= 598 and etMin < 615))) or (isFomc and etMin >= 838 and etMin < 900) or (etMin >= 570 and etMin < 600) or (etMin >= 945 and etMin < 975) or (etMin >= 1005 and etMin < 1020) or (etMin >= 1080 and etMin < 1110)
bool evtNow  = avoidEvt and inEvt
bool haltBar = flatHalt and isCME and etMin == 1020                 // 美東 17:00 收盤那根，接著休市
bool mixPm   = mixPmOff and etMin >= 960 and etMin < 1200           // 美東 16:00–20:00（收盤後）不做 MIX 突破
// 週五美股盤的最後幾小時（台灣時間週六 friCutH:friCutM 以後）不發新訊號
int  twMin   = hour(tClose, "Asia/Taipei") * 60 + minute(tClose, "Asia/Taipei")
bool friLate = friCut and dayofweek(tClose, "Asia/Taipei") == dayofweek.saturday and twMin >= friCutH * 60 + friCutM

// ═════════════════ NQ 2 分 K 的 Trend Judge（QQQ 用）═════════════════
// NQ 2 分 K（24 小時）收盤推算 5 秒 / 15 秒 EMA1130（每根走 120 / 秒數 步），門檻 10 / 35；取上一根已收完的 K，不重繪
nqTJ() =>
    float aF = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 120.0 / tjFastS)
    float aS = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 120.0 / tjSlowS)
    var float ef = na
    var float es = na
    ef := na(ef) ? close : ef + aF * (close - ef)
    es := na(es) ? close : es + aS * (close - es)
    float dd = ef - es
    int dir = dd > 35 ? 2 : dd > 10 ? 1 : dd < -35 ? -2 : dd < -10 ? -1 : 0
    int sg  = dir > 0 ? 1 : dir < 0 ? -1 : 0
    var int nb = 0
    nb := sg != 0 and sg == nz(sg[1]) ? nb + 1 : sg != 0 ? 1 : 0
    [dd[1], dir[1], nb[1] * 2]
[nqDiff, nqDir, nqMin] = request.security(ticker.modify(nqSym, session.extended), "2", nqTJ(), lookahead=barmerge.lookahead_on)
bool qNqUse   = (isQQ or isNqR) and qNqOn
bool nqHas    = not na(nqDir)
bool nqBuyOk  = not qNqUse or not nqHas or nqDir >= 0
bool nqSellOk = not qNqUse or not nqHas or nqDir <= 0

// ═════════════════ 趨勢訊號 ═════════════════
h1Vals() =>
    float h1e = ta.ema(close, h1Len)
    [close[1], h1e[1]]
[h1Close, h1Ema] = request.security(syminfo.tickerid, "60", h1Vals(), lookahead=barmerge.lookahead_on)
float atrPrev  = ta.atr(atrLen)[1]
float atrNow   = ta.atr(atrLen)
float buyStop  = math.min(low, low[1])
float sellStop = math.max(high, high[1])
bool trBuy  = active and buySig and tjLinked and tjDirI >= 1 and not na(h1Ema) and h1Close > h1Ema and not na(atrPrev) and close - buyStop >= riskMult * atrPrev and not na(tjMaSlow) and close - tjMaSlow <= distU * atrNow and not evtNow and inWin and nqBuyOk and not friLate
bool trSell = active and sellSig and tjLinked and tjDirI <= -1 and not na(h1Ema) and h1Close < h1Ema and not na(atrPrev) and sellStop - close >= riskMult * atrPrev and not na(tjMaSlow) and tjMaSlow - close <= distU * atrNow and not evtNow and inWin and nqSellOk and not friLate

// ═════════════════ GEX：QQQ 現價跟手動輸入的 gamma flip 比（只顯示）═════════════════
float qqqPx   = isQQ ? close : request.security(qqqSym, timeframe.period, close)
bool  gexHas  = gexOn and gexFlip > 0 and not na(qqqPx)
float gexDiff = gexHas ? qqqPx - gexFlip : na
plot(gexOn and gexLine and isQQ and gexFlip > 0 ? gexFlip : na, "QQQ gamma flip", color=gexCol, linewidth=1, style=plot.style_linebr)

// ═════════════════ GEX setup（NQ RTH）：(35, 0, 8, 1) + Trend Judge 順勢 + 朝 QQQ gamma flip 走 ═════════════════
bool gsActive = gsOn and isNqR and (tfp == "1" or otherTf)
bool gsReady  = gexFlip > 0 and not na(qqqPx)
bool gNewLow  = low < ta.lowest(low, gsStage)[1]
bool gNewHigh = high > ta.highest(high, gsStage)[1]
var float gRefHigh = na
var float gRefLow  = na
var bool  gArmBuy  = false
var bool  gArmSell = false
float gEma      = ta.ema(close, gsEma)
bool  gTrigBuy  = gArmBuy and close > gRefHigh
bool  gTrigSell = gArmSell and close < gRefLow
if gTrigBuy
    gArmBuy := false
else if gNewLow
    gRefHigh := high
    gArmBuy  := true
if gTrigSell
    gArmSell := false
else if gNewHigh
    gRefLow  := low
    gArmSell := true
bool gsEnd  = etMin >= 960 or session.islastbar                 // 美東 16:00 收盤（同回測只用到 16:00）
int  gsLS   = gsLH1 * 60 + gsLM1
int  gsLE   = gsLH2 * 60 + gsLM2
bool gsLunchNow = gsLunch and (gsLS <= gsLE ? twMin >= gsLS and twMin <= gsLE : twMin >= gsLS or twMin <= gsLE)   // 台灣時間這段不發 GEX 訊號
string gsLunchTxt = str.format("{0,number,00}:{1,number,00}–{2,number,00}:{3,number,00}", gsLH1, gsLM1, gsLH2, gsLM2)
bool gsBuy  = gsActive and gsReady and gTrigBuy and close > gEma and barstate.isconfirmed and tjLinked and tjDirI >= 1 and qqqPx < gexFlip and not friLate and not gsEnd and not gsLunchNow
bool gsSell = gsActive and gsReady and gTrigSell and close < gEma and barstate.isconfirmed and tjLinked and tjDirI <= -1 and qqqPx > gexFlip and not friLate and not gsEnd and not gsLunchNow
var int   gsPos   = 0
var float gsEntry = na
var float gsStop  = na
var float gsTgt   = na
var int   gsBar   = na
if gsPos != 0 and bar_index > gsBar
    bool gHitS = gsPos == 1 ? low <= gsStop : high >= gsStop
    bool gHitT = gsPos == 1 ? high >= gsTgt : low <= gsTgt
    if gHitS or gHitT or bar_index - gsBar >= holdBars or gsEnd or (not na(time[1]) and time - time[1] > 30 * 60 * 1000)
        gsPos := 0
bool gsGoBuy  = gsBuy and gsPos == 0
bool gsGoSell = gsSell and gsPos == 0 and not gsGoBuy
if gsGoBuy or gsGoSell
    gsPos   := gsGoBuy ? 1 : -1
    gsEntry := close
    gsStop  := gsGoBuy ? math.min(low, low[1]) : math.max(high, high[1])
    gsTgt   := close + 3.0 * (close - gsStop)
    gsBar   := bar_index

// ═════════════════ MIX 區間（只有 NQ 2、5 分 K；美東 16–20 的突破不做）═════════════════
float tfMin   = tfSec / 60.0
int   mbNeed  = math.max(1, math.round(60 / tfMin))
int   mbGrace = math.max(0, math.round(4 / tfMin))
int   mbLife  = math.max(1, math.round(60 / tfMin))
bool  mbHole  = not na(time[1]) and time - time[1] > 30 * 60 * 1000
bool  isMix   = tjLinked and tjDirI == 0
var int   mbStart  = na
var int   mbRun    = 0
var float mbHi     = na
var float mbLo     = na
var bool  mbFormed = false
if mbHole
    mbStart := na
    mbRun   := 0
if isMix
    if na(mbStart)
        mbStart  := bar_index
        mbHi     := high
        mbLo     := low
        mbFormed := false
    else
        mbHi := math.max(mbHi, high)
        mbLo := math.min(mbLo, low)
    mbRun := 0
else if not na(mbStart)
    if tjLinked and tjDirI != 0
        mbRun += 1
        if mbRun > mbGrace
            mbStart := na
            mbRun   := 0
        else
            mbHi := math.max(mbHi, high)
            mbLo := math.min(mbLo, low)
    else
        mbStart := na
        mbRun   := 0
var float bxTop  = na
var float bxBot  = na
var int   bxLeft = na
var int   bxForm = na
var int   bxEnd  = na
var bool  bxLive = false
bool mbForm = false
if not na(mbStart) and not mbFormed and bar_index - mbStart + 1 >= mbNeed
    mbFormed := true
    mbForm   := true
    bxTop    := mbHi
    bxBot    := mbLo
    bxLeft   := mbStart
    bxForm   := bar_index
    bxEnd    := bar_index + mbLife
    bxLive   := mbHi > mbLo
float bxH   = bxTop - bxBot
float bxUpL = bxTop + 0.1 * bxH
float bxDnL = bxBot - 0.1 * bxH
float bxMid = (bxTop + bxBot) / 2
float mixTgtR = mixClose ? 2.0 : tgtR
bool mxBuy  = false
bool mxSell = false
if bxLive and not mbForm and bar_index > bxForm
    if bar_index > bxEnd or mbHole
        bxLive := false
    else
        bool upHit = mixClose ? close > bxUpL and barstate.isconfirmed : high >= bxUpL      // 等收線：收盤在突破價外才算
        bool dnHit = mixClose ? close < bxDnL and barstate.isconfirmed : low <= bxDnL
        if upHit or dnHit
            bxLive := false
            if not (upHit and dnHit) and not evtNow and not mixPm
                mxBuy  := active and mixUse and upHit
                mxSell := active and mixUse and dnHit
var line bxUpLine = na
var line bxDnLine = na
if active and mixUse and mbForm and bxLive and showBox and not na(bxTop) and not na(bxBot)
    box.new(bxLeft, bxTop, bar_index, bxBot, border_color=boxLnCol, bgcolor=boxCol)
    int lineEnd = bar_index + math.min(mbLife, 500)
    bxUpLine := line.new(bar_index, bxUpL, lineEnd, bxUpL, color=boxLnCol, style=line.style_dashed)
    bxDnLine := line.new(bar_index, bxDnL, lineEnd, bxDnL, color=boxLnCol, style=line.style_dashed)
if (mxBuy or mxSell) and showBox and not na(bxUpLine) and not na(bxDnLine)
    line.set_x2(bxUpLine, bar_index)
    line.set_x2(bxDnLine, bar_index)

// ═════════════════ 一次一筆：虛擬持倉 ═════════════════
var int   vPos   = 0
var float vEntry = na
var float vStop  = na
var float vTgt   = na
var int   vBar   = na
var int   vKind  = 0          // 1 趨勢、2 MIX 突破
if vPos != 0 and bar_index > vBar
    bool hitStop = vPos == 1 ? low <= vStop : high >= vStop
    bool hitTgt  = vPos == 1 ? high >= vTgt : low <= vTgt
    if hitStop or hitTgt or bar_index - vBar >= holdBars or haltBar or mbHole
        vPos := 0
bool flatNow = not onlyOne or vPos == 0
bool goMixBuy  = mxBuy and flatNow and not haltBar and not friLate
bool goMixSell = mxSell and flatNow and not haltBar and not friLate and not goMixBuy
float mxEntry = goMixBuy ? (mixClose ? close : math.max(open, bxUpL)) : goMixSell ? (mixClose ? close : math.min(open, bxDnL)) : na
if goMixBuy or goMixSell
    vPos   := goMixBuy ? 1 : -1
    vEntry := mxEntry
    vStop  := bxMid
    vTgt   := mxEntry + mixTgtR * (mxEntry - bxMid)
    vBar   := bar_index
    vKind  := 2
    if not mixClose and ((vPos == 1 and low <= vStop) or (vPos == -1 and high >= vStop))     // 掛單進場：同一根碰到停損就出場
        vPos := 0
bool flatClose = not onlyOne or vPos == 0
bool goTrBuy  = trBuy and flatClose and not haltBar
bool goTrSell = trSell and flatClose and not haltBar and not goTrBuy
if goTrBuy or goTrSell
    vPos   := goTrBuy ? 1 : -1
    vEntry := close
    vStop  := goTrBuy ? buyStop : sellStop
    vTgt   := close + tgtR * (close - vStop)
    vBar   := bar_index
    vKind  := 1

bool tradeBuy  = goMixBuy or goTrBuy
bool tradeSell = goMixSell or goTrSell
float sigEntry = goTrBuy or goTrSell ? close : mxEntry
float sigStop  = goTrBuy ? buyStop : goTrSell ? sellStop : (goMixBuy or goMixSell) ? bxMid : na
float sigTgt   = na(sigEntry) or na(sigStop) ? na : sigEntry + ((goMixBuy or goMixSell) ? mixTgtR : tgtR) * (sigEntry - sigStop)

// ═════════════════ 圖上標記 ═════════════════
markSz = markSize == "小" ? size.small : markSize == "大" ? size.large : size.normal
gsSz   = gsSize == "小" ? size.small : gsSize == "大" ? size.large : size.normal
string markPad = ""
if markLines > 0
    for k = 1 to markLines
        markPad := markPad + "\n"
drawBuyMark(txt) =>
    label.new(bar_index, low, markPad + txt, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_none, textcolor=txtCol, size=markSz)
drawSellMark(txt) =>
    label.new(bar_index, high, txt + markPad, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_none, textcolor=txtCol, size=markSz)
if goMixBuy
    drawBuyMark(mBuyTxt)
if goMixSell
    drawSellMark(mSellTxt)
if goTrBuy
    drawBuyMark(tBuyTxt)
if goTrSell
    drawSellMark(tSellTxt)
// GEX setup 的記號：沒有底色，緊貼在那根 K 的低點下方（買）/ 高點上方（賣），不會跟 v3 的記號混在一起
if gsGoBuy
    label.new(bar_index, low, gsBuyTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(color.white, 100), textcolor=gexCol, size=gsSz)
if gsGoSell
    label.new(bar_index, high, gsSellTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=gexCol, size=gsSz)
plot(showPos and gsPos != 0 ? gsStop : na, "GEX 持倉停損", color=color.new(stopCol, 40), style=plot.style_linebr)
plot(showPos and gsPos != 0 ? gsTgt : na, "GEX 持倉目標", color=color.new(tgtCol, 40), style=plot.style_linebr)
bool inPos = vPos != 0
plot(showPos and inPos ? vStop : na, "持倉停損", color=stopCol, style=plot.style_linebr)
plot(showPos and inPos ? vTgt : na, "持倉目標", color=tgtCol, style=plot.style_linebr)

// 給快訊用的數值（只出現在資料視窗）
plot(tradeBuy ? 1 : 0, "可交易 Buy", display=display.data_window)
plot(tradeSell ? 1 : 0, "可交易 Sell", display=display.data_window)
plot(sigEntry, "v3 進場", display=display.data_window)
plot(sigStop, "v3 停損", display=display.data_window)
plot(sigTgt, "v3 目標", display=display.data_window)
plot(trendMin, "趨勢已持續（分鐘）", display=display.data_window)
plot(tjDiff, "TJ 差值", display=display.data_window)
plot(nqDiff, "NQ 2m TJ 差值", display=display.data_window)
plot(nqMin, "NQ 2m 趨勢已持續（分鐘）", display=display.data_window)
plot(gsGoBuy or gsGoSell ? close : na, "GEX 進場", display=display.data_window)
plot(gsGoBuy or gsGoSell ? gsStop : na, "GEX 停損", display=display.data_window)
plot(gsGoBuy or gsGoSell ? gsTgt : na, "GEX 目標", display=display.data_window)

// ═════════════════ 狀態表格（配色同原始 Trend Judge）═════════════════
tblWhere = tblPos == "左上" ? position.top_left : tblPos == "右上" ? position.top_right : tblPos == "左下" ? position.bottom_left : position.bottom_right
tblTxt   = tblSize == "極小" ? size.tiny : tblSize == "小" ? size.small : tblSize == "大" ? size.large : size.normal
var table st = table.new(tblWhere, 2, tblPad + 9, border_width=1)
fmtP(float v) =>
    str.tostring(v, format.mintick)
addRow(int r, string lbl, string val, color vb, string ha) =>
    table.cell(st, 0, r, lbl, text_color=color.white, bgcolor=color.new(color.black, 20), text_size=tblTxt)
    table.cell(st, 1, r, val, text_color=color.white, bgcolor=vb, text_size=tblTxt, text_halign=ha)
if barstate.islast and showTbl
    table.clear(st, 0, 0, 1, tblPad + 8)
    bool  compact = tblStyle == "精簡"
    string ha     = compact ? text.align_center : text.align_left    // 精簡置中，完整靠左
    color bg      = color.new(color.black, 20)
    color blank   = color.new(color.black, 100)
    int padUse = tblPos == "左上" or tblPos == "右上" ? tblPad : 0
    if padUse > 0
        for r = 0 to padUse - 1
            table.cell(st, 0, r, " ", text_color=blank, bgcolor=blank, text_size=tblTxt)
            table.cell(st, 1, r, " ", text_color=blank, bgcolor=blank, text_size=tblTxt)
    int row = padUse
    // 設定
    color  setCol = gradeTxt == "主力" ? color.new(#2962FF, 30) : gradeTxt == "可做" ? color.new(#2962FF, 55) : gradeTxt == "邊緣" ? color.new(color.orange, 40) : color.new(color.red, 30)
    string setTxt = prof == "無" ? "不支援 " + syminfo.ticker : compact ? prof + " " + tfp + "m " + gradeTxt : prof + " " + tfp + " 分 K（" + gradeTxt + "）\n" + ruleTxt
    addRow(row, "設定", setTxt, setCol, ha)
    row += 1
    // Trend Judge 和趨勢已持續
    string tjTxt = not tjLinked ? "沒有資料" : tjDirI == 2 ? "強UP" : tjDirI == 1 ? "UP" : tjDirI == -2 ? "強Down" : tjDirI == -1 ? "DOWN" : "MIX"
    color  tjCol = not tjLinked ? color.gray : tjDirI == 2 ? color.lime : tjDirI == 1 ? color.green : tjDirI == -2 ? color.maroon : tjDirI == -1 ? color.red : color.orange
    if compact
        string tjShort = tjTxt + (trendDir != 0 ? " " + str.tostring(trendMin, "#") + "分" + (useWin and inWin ? " ✅" : "") : "")
        addRow(row, "趨勢", tjShort, tjCol, ha)
        row += 1
    else
        addRow(row, "Trend Judge", tjTxt, tjCol, ha)
        row += 1
        string ageTxt = trendDir == 0 ? "MIX（沒有趨勢）" : str.tostring(trendMin, "#") + " 分" + (not useWin ? "" : inWin ? "　✅ 在 " + str.tostring(winLo) + "–" + str.tostring(winHi) + " 分內" : trendMin < winLo ? "　再 " + str.tostring(winLo - trendMin, "#") + " 分進入範圍" : "　已超過 " + str.tostring(winHi) + " 分")
        addRow(row, "趨勢已持續", ageTxt, trendDir != 0 and useWin and inWin ? color.new(#2962FF, 30) : bg, ha)
        row += 1
    // 持倉
    color  posCol = vPos == 1 ? color.new(color.green, 40) : vPos == -1 ? color.new(color.red, 40) : bg
    string posTxt = compact ? (not active ? "不發訊號" : vPos == 0 ? "空手" : (vPos == 1 ? "多" : "空") + " 停 " + fmtP(vStop) + " 標 " + fmtP(vTgt)) : not active ? "這個商品 / 週期不發訊號" : vPos == 0 ? "空手，可以接訊號" : (vPos == 1 ? "多單" : "空單") + (vKind == 2 ? "（MIX 突破）" : "（趨勢）") + "　進 " + fmtP(vEntry) + "　停 " + fmtP(vStop) + "　標 " + fmtP(vTgt) + "　已 " + str.tostring(bar_index - vBar) + " 根"
    addRow(row, compact ? "持倉" : "持倉（虛擬）", posTxt, posCol, ha)
    row += 1
    // NQ 2m（QQQ、NQ RTH）
    if qNqUse
        string nqState = not nqHas ? "讀不到" : nqDir == 2 ? "強UP" : nqDir == 1 ? "UP" : nqDir == -2 ? "強Down" : nqDir == -1 ? "DOWN" : "MIX"
        string nqTxt   = compact ? nqState + (nqHas and nqDir != 0 ? " " + str.tostring(nqMin, "#") + "分" : "") + (nqHas ? (nqDir > 0 ? " 只做買" : nqDir < 0 ? " 只做賣" : " 都可以") : "") : not nqHas ? "讀不到 " + nqSym + "（不擋訊號）" : nqState + (nqDir != 0 ? "　趨勢 " + str.tostring(nqMin, "#") + " 分" : "") + "　→ " + (nqDir > 0 ? "只做買" : nqDir < 0 ? "只做賣" : "買賣都可以")
        color  nqCol   = not nqHas ? color.gray : nqDir == 2 ? color.lime : nqDir == 1 ? color.green : nqDir == -2 ? color.maroon : nqDir == -1 ? color.red : color.orange
        addRow(row, "NQ 2m", nqTxt, nqCol, ha)
        row += 1
    // GEX：朝 flip 走 / 離開 flip（只顯示）
    if gexOn
        string gexTxt = ""
        if not gexHas
            gexTxt := compact ? "請輸入 flip" : "請在設定輸入 QQQ 的 gamma flip 價位"
        else
            bool below = gexDiff < 0
            string dist = str.tostring(math.abs(gexDiff), "#.##")
            string pct  = str.tostring(math.abs(gexDiff) / gexFlip * 100, "#.##")
            gexTxt := compact ? (below ? "下 " + dist + "　買朝 flip ✅" : "上 " + dist + "　賣朝 flip ✅") : "QQQ " + str.tostring(qqqPx, "#.##") + " 在 flip " + str.tostring(gexFlip, "#.##") + (below ? " 下面 " : " 上面 ") + dist + "（" + pct + "%）→ " + (below ? "買：朝 flip 走 ✅　賣：離開 flip" : "賣：朝 flip 走 ✅　買：離開 flip")
        addRow(row, "Flip", gexTxt, color.new(#9C27B0, 40), ha)
        row += 1
    // GEX setup（只有 NQ RTH）：持倉，或現在為什麼沒有訊號（setup 開關、週期、flip、時間、趨勢、訊號還差什麼）
    if isNqR and (gsOn or gexOn)
        string gsTxt = ""
        bool   gsOk  = false
        if not gsOn
            gsTxt := compact ? "setup 沒開" : "GEX setup 沒打開（設定 → GEX）"
        else if not gsActive
            gsTxt := compact ? "要 1 分 K" : "GEX setup 只在 NQ RTH 1 分 K"
        else if not gsReady
            gsTxt := compact ? "請輸入 flip" : "請輸入 QQQ 的 gamma flip"
        else if gsPos != 0
            gsTxt := (gsPos == 1 ? "多" : "空") + " 停 " + fmtP(gsStop) + " 標 " + fmtP(gsTgt)
            gsOk  := true
        else
            bool   wantBuy = qqqPx < gexFlip
            string sideTxt = wantBuy ? "等買" : "等賣"
            string flipTxt = "QQQ 在 flip " + (wantBuy ? "下 → 只等買" : "上 → 只等賣")
            bool   trOk    = tjLinked and (wantBuy ? tjDirI >= 1 : tjDirI <= -1)
            string tjNow   = not tjLinked ? "沒資料" : tjDirI == 2 ? "強UP" : tjDirI == 1 ? "UP" : tjDirI == -2 ? "強Down" : tjDirI == -1 ? "DOWN" : "MIX"
            string timeBad = friLate ? "週五截止後" : gsEnd ? "16:00 後" : gsLunchNow ? "台灣 " + gsLunchTxt + " " : ""
            bool   armed   = wantBuy ? gArmBuy : gArmSell
            float  trigPx  = wantBuy ? gRefHigh : gRefLow
            if timeBad != ""
                gsTxt := compact ? timeBad + "不做" : flipTxt + "；" + timeBad + "不發新訊號"
            else if not trOk
                gsTxt := compact ? sideTxt + "｜趨勢 " + tjNow + " ✗" : flipTxt + "；趨勢 " + tjNow + "，要 " + (wantBuy ? "UP" : "DOWN") + " 才做 ✗"
            else
                gsOk := true
                string trigShort = armed ? (wantBuy ? "收 > " : "收 < ") + fmtP(trigPx) : "等創 " + str.tostring(gsStage) + (wantBuy ? " 根新低" : " 根新高")
                string trigLong  = armed ? (wantBuy ? "收盤站上 " : "收盤跌破 ") + fmtP(trigPx) + (wantBuy ? " 而且在 EMA 上" : " 而且在 EMA 下") : "還沒創 " + str.tostring(gsStage) + (wantBuy ? " 根新低（要先回檔）" : " 根新高（要先反彈）")
                gsTxt := compact ? sideTxt + "｜趨勢 ✓｜" + trigShort : flipTxt + "；趨勢 " + tjNow + " ✓；訊號：" + trigLong
        color gsCol = gsPos == 1 ? color.new(color.green, 40) : gsPos == -1 ? color.new(color.red, 40) : gsOk ? color.new(#9C27B0, 30) : color.new(color.gray, 30)
        addRow(row, compact ? "GEX" : "GEX setup", gsTxt, gsCol, ha)
        row += 1
    // MIX 區間（精簡時只在 NQ 2、5 分 K 顯示）
    if mixUse or not compact
        string mixTxt = not mixUse ? "這個商品 / 週期不做" : bxLive and bar_index <= bxEnd ? (compact ? (mixClose ? "收 " : "") + "上 " + fmtP(bxUpL) + " 下 " + fmtP(bxDnL) : (mixClose ? "等收線突破　上 " : "等突破　上 ") + fmtP(bxUpL) + "　下 " + fmtP(bxDnL) + "　剩 " + str.tostring((bxEnd - bar_index) * tfMin, "#") + " 分") : not na(mbStart) ? (compact ? "成形中 " + str.tostring((bar_index - mbStart + 1) * tfMin, "#") + "分" : "MIX 已 " + str.tostring((bar_index - mbStart + 1) * tfMin, "#") + " 分（滿 60 分成形）") : (compact ? "無" : "沒有區間")
        addRow(row, compact ? "MIX" : "MIX 區間", mixTxt, bg, ha)
        row += 1
    // 提示
    string warn = ""
    if prof == "無"
        warn := compact ? "不支援這個商品" : "支援 NQ / ES / TXF / QQQ / SPY（含 MNQ、MES、MXF）"
    else if friLate
        warn := compact ? "週五 " + str.format("{0,number,00}:{1,number,00}", friCutH, friCutM) + " 後不交易" : "週五 " + str.format("{0,number,00}:{1,number,00}", friCutH, friCutM) + " 以後不發新訊號（交易規則設定）"
    else if isES and not esOn
        warn := compact ? "ES 預設不發" : "ES 回測每種做法都虧，預設不發訊號"
    else if isNQ and tfp == "1" and profSel == "自動"
        warn := compact ? "1m 請開 RTH 或選 NQ RTH" : "NQ 1 分 K 要用 NQ RTH：圖表時段切 RTH（" + (na(lastNight) ? "已經 " + str.tostring(bar_index) + " 根 K，要 1500 根才會自動切換" : "最近一根美股盤外的 K 在 " + str.tostring(bar_index - lastNight) + " 根前，要超過 1500 根") + "），或在「商品」選「NQ RTH（代替 QQQ）」"
    else if not okTf
        warn := compact ? "建議 " + (isETF ? "1" : isNQ ? "2、3 或 5" : "2 或 3") + " 分 K" : "建議週期：" + (isETF ? "1 分 K" : isNQ ? "2、3 或 5 分 K" : "2 或 3 分 K") + "，目前 " + tfp + (otherTf ? "（照設定仍發訊號，沒有回測過）" : "（不發訊號）")
    else if (isQQ or isSP) and syminfo.session == session.extended
        warn := compact ? "請關延長時段" : "請關掉延長交易時段，回測只用美股盤 09:30–16:00"
    else if isTX
        warn := compact ? "邊緣，成本高" : "回測只小賺，成本 4 點時接近打平；結算日夜盤到隔天不要做"
    else if active and mixUse and mixPm
        warn := compact ? "16–20 不做 MIX" : "美東 16:00–20:00 不做 MIX 突破，趨勢訊號照常（交易規則設定）"
    if warn != ""
        addRow(row, "提示", warn, color.new(color.orange, 20), ha)

// ═════════════════ 快訊：v3 兩個（所有商品共用）+ GEX setup 兩個（NQ RTH，預設關）═════════════════
// 觸發選「每根 K 線一次」：NQ 2、5 分 K 的 MIX 突破碰到突破價就通知（盤中），其他訊號在 K 棒收盤時通知
// 選了「MIX 等收線才進場」：MIX 突破也在 K 棒收盤時通知，訊息的進場價是收盤價、目標 2R
alertcondition(tradeBuy, "Remi Superb v3 Buy", '{{ticker}} Remi Superb v3 Buy｜進場 {{plot("v3 進場")}}｜停損 {{plot("v3 停損")}}｜目標 {{plot("v3 目標")}}')
alertcondition(tradeSell, "Remi Superb v3 Sell", '{{ticker}} Remi Superb v3 Sell｜進場 {{plot("v3 進場")}}｜停損 {{plot("v3 停損")}}｜目標 {{plot("v3 目標")}}')
// GEX setup：觸發選「每根 K 線一次」，K 棒收盤時通知（要先在設定打開 GEX setup、輸入 flip）
alertcondition(gsGoBuy, "Remi Superb v3 GEX Buy", '{{ticker}} Remi Superb v3 GEX Buy｜進場 {{plot("GEX 進場")}}｜停損 {{plot("GEX 停損")}}｜目標 {{plot("GEX 目標")}}')
alertcondition(gsGoSell, "Remi Superb v3 GEX Sell", '{{ticker}} Remi Superb v3 GEX Sell｜進場 {{plot("GEX 進場")}}｜停損 {{plot("GEX 停損")}}｜目標 {{plot("GEX 目標")}}')
