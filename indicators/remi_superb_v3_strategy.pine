//@version=6
// Remi Superb v3 策略：給 TradingView 策略測試器回測用，訊號和規則同 Remi Superb v3（自動辨識商品和週期），說明見 indicators/remi_superb.md 第 8 節
//   NQ / MNQ 2 分 K：趨勢訊號（趨勢 0–400 分）+ MIX 區間突破，目標 3R
//   NQ / MNQ 3 分 K：趨勢訊號（趨勢 90–120 分），目標 1R
//   NQ / MNQ 5 分 K：趨勢訊號（趨勢 0–180 分）+ MIX 區間突破，目標 2R
//   QQQ / SPY 1 分 K、NQ 1 分 K 只開美股盤（RTH）：(35, 0, 8, 1)，目標 3R（QQQ、NQ RTH 另加 NQ 2 分 K 不反向）
//   TXF / MXF 2、3 分 K：趨勢訊號（趨勢 60–120 分），目標 3R；ES / MES 預設不做
// 下單：
//   趨勢訊號：訊號 K 收盤市價進場，停損在訊號 K 和前一根的極值
//   MIX 突破：區間形成後 60 分鐘內，在上下突破價（區間高度 10%）掛停損單，一邊成交就取消另一邊，停損在中線；
//             下一根 K 在事件時段、美東 16:00–20:00、休市那根、週五截止後就不掛；第一次碰到突破價（不論有沒有成交）區間就作廢
//             選項「等收線才進場」：改成 K 棒收在突破價外才在收盤市價進場，目標 2R（預設關）
//   NQ 5m 不逆日線 SMA5（預設開）：買要在日 K SMA5 上方、賣要在下方（趨勢和 MIX）
//   NQ 2m 停損後再進場（預設開）：停損後 5 根內 Trend Judge 同方向、收回原進場價就同方向再進一次（R L / R S），兩根 K 停損、3R
//   一次一筆；持有 60 根 K 還沒出場就收盤平倉；NQ / ES 美東 17:00 休市前平倉；TXF、QQQ、SPY、NQ RTH 在每段交易時間最後一根平倉
//   不開新倉：事件時段、收盤後美東 15:45–18:30（NQ / ES）、垃圾時間（美東 12:00–13:05）、FOMC 日、週五台灣時間週六 02:00 以後
// Trend Judge 用 1 分 K 收盤推算（同回測）；沒有 1 分資料的舊 K 棒自動改用圖表 K 棒推算
// 出場管理（預設兩組）：每筆進「口數 × 2」，第一組 1R 先出，第二組照原停損和目標
// 開盤高開低走（預設開，NQ RTH 1 / 2 分 K）：高開 ≥ 0.75%、第一根 2 分鐘收黑還在昨收上 → 09:32 收盤做空、1R（O S）
// GEX setup（預設關，NQ RTH 1 分 K）：(35, 0, 8, 1) + Trend Judge 順勢 + 朝手動輸入的 QQQ flip 走，目標 3R；垃圾時間只做賣
//   跟 v3 的單共用一個倉位（空手才進場）；回測整段歷史都用同一個 flip，所以 GEX setup 的歷史回測不準
strategy("Remi Superb v3 策略", overlay=true, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000, currency=currency.USD, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2, margin_long=0, margin_short=0, max_boxes_count=500, max_lines_count=500)

// ═════════════════ 1. 商品 ═════════════════
grpP      = "商品"
profSel   = input.string("自動", "商品", options=["自動", "NQ", "NQ RTH（代替 QQQ）", "ES", "TXF", "QQQ", "SPY"], group=grpP, tooltip="自動：依圖上的商品選做法（NQ / MNQ、ES / MES、TXF / MXF / TMF、QQQ、SPY）。NQ 圖只開美股盤時自動改用「NQ RTH」，做法同 QQQ。也可以手動指定")
otherTf   = input.bool(false, "不是建議週期也交易", group=grpP, tooltip="建議週期：NQ 2、3、5 分 K；TXF 2、3 分 K；QQQ、SPY、NQ RTH 1 分 K。關（預設）：其他週期不交易。開：用最接近的做法（沒有回測過）")
esOn      = input.bool(false, "ES 也交易（回測是虧的）", group=grpP, tooltip="ES / MES 2、3 分 K 回測每一種做法都虧，所以預設不做。打開會用 NQ 2 分 K 的做法（門檻 4 點、不做 MIX）")

// ═════════════════ 2. 下單 ═════════════════
grpQ      = "下單"
qtyFut    = input.int(1, "期貨口數", minval=1, group=grpQ, tooltip="NQ / MNQ / ES / MES / TXF / MXF 每筆幾口。NQ 1 點 = 20 美元，MNQ 1 點 = 2 美元。手續費（每口每邊）和滑價（跳動點）在「屬性」分頁改：預設 2.5 美元、2 跳；MNQ 建議手續費改約 0.6")
qtyEtf    = input.int(100, "QQQ / SPY 股數", minval=1, group=grpQ, tooltip="QQQ / SPY 每筆幾股。「屬性」分頁的手續費是每口（= 每股）計，回測 QQQ / SPY 時請改成每股約 0.005 美元，否則成本會被高估很多")
exitMode  = input.string("兩組：1R 先出一組，另一組照原停損和目標", "出場管理", options=["兩組：1R 先出一組，另一組照原停損和目標", "全部照目標"], group=grpQ, tooltip="兩組（預設，2026-10-21）：每筆進場「口數 × 2」，第一組到 1R 先出，第二組照原本的停損和目標（2m 3R、5m 2R）；第一組出場後第二組打到原停損也只是打平。回測 NQ 2m v3 那年（每筆 2 口）：賺錢 42%、打平 16%、虧 42%，+8466 點、回撤 871 點；全部照目標是賺錢 40%、+11598 點、回撤 1074 點。1R 先出那一組的快訊 action 是 partial；autotrade（split_first_r = 1）進場時就在 IBKR 掛好兩組出場單，所以會略過 partial 快訊")
useTrend  = input.bool(true, "做趨勢訊號", group=grpQ)
useMix    = input.bool(true, "做 MIX 區間突破（NQ 2、5 分 K）", group=grpQ)

// ═════════════════ 3. GEX：QQQ gamma flip ═════════════════
grpG      = "GEX：QQQ gamma flip"
gexFlip   = input.float(0.0, "QQQ gamma flip", minval=0, step=0.01, group=grpG, tooltip="從 ZeroGEX 抄 QQQ 的 gamma flip（填 QQQ 的價格，不是 NQ）；0 = 還沒填，GEX setup 不做。注意：策略回測整段歷史都用這一個值，實際 flip 每天都不同，所以 GEX setup 的歷史回測不準，只有填的那天之後才有意義（快訊下單沒問題）")
qqqSym    = input.symbol("NASDAQ:QQQ", "QQQ 代號", group=grpG, tooltip="在 NQ 圖上用這個代號讀 QQQ 現價來跟 flip 比")

// ═════════════════ 4. GEX setup（NQ RTH 1 分 K）═════════════════
grpX      = "GEX setup（NQ RTH 1 分 K）"
gsOn      = input.bool(false, "做 GEX setup（目標 3R）", group=grpX, tooltip="只在 NQ RTH 1 分 K：原版訊號（下面的階段、EMA）+ Trend Judge 同向（門檻 20 點）+ 朝 QQQ flip 走（QQQ 在 flip 下方只做買、上方只做賣），收盤市價進場，停損在訊號 K 和前一根的極值，目標 3R，持有 60 根或美東 16:00 平倉；週五截止後不做。跟指標版不同：這裡和 v3 的單共用一個倉位，要空手才進場，同一根 v3 也有單時做 v3 的")
gsStage   = input.int(35, "階段", minval=2, group=grpX, inline="gs")
gsEma     = input.int(8, "Ema number", minval=1, group=grpX, inline="gs", tooltip="預設 (35, 0, 8, 1)，同指標版")
gsJunkSell = input.bool(true, "垃圾時間照做 GEX 賣單", group=grpX, tooltip="垃圾時間（「不交易的時間」設定）所有單都不做，只有 GEX setup 的賣單例外，同指標版")

// ═════════════════ 4b. 開盤高開低走（NQ RTH）═════════════════
grpU      = "開盤高開低走 setup（NQ RTH）"
goOn      = input.bool(true, "做開盤高開低走（做空，目標 1R）", group=grpU, tooltip="只在 NQ RTH 1 或 2 分 K：09:30 開盤比前一天 16:00 收盤高開 ≥ 下面的 %，第一根 2 分鐘 K（09:30–09:32）收黑、還在昨收之上，就在 09:32 收盤市價做空（訂單 O S），停損第一根 2 分鐘最高點上 1 跳，目標 1R，16:00 收盤平倉。跟 v3 的單共用倉位（空手才進場）。回測（五年，缺口 ≥ 0.75%）：94 筆、1R 勝率 65%、每筆 +0.27R")
goGap     = input.float(0.75, "最小高開（%）", minval=0, step=0.05, group=grpU, inline="go")
goR       = input.float(1.0, "目標（R）", minval=0.1, step=0.5, group=grpU, inline="go")

// ═════════════════ 5. 趨勢訊號過濾 ═════════════════
grpR      = "趨勢訊號過濾"
h1Len     = input.int(20, "1 小時 EMA 長度", minval=1, group=grpR, tooltip="看上一根已收完的 1 小時 K：買要收在 EMA 上方，賣要在下方。回測 EMA 15–30 都接近、20 最好")
riskMult  = input.float(0.95, "停損至少（ATR 倍數）", minval=0, step=0.05, group=grpR, inline="rk")
atrLen    = input.int(14, "ATR 長度", minval=1, group=grpR, inline="rk", tooltip="停損 = 訊號 K 和前一根的最低點（買）/ 最高點（賣）；停損距離小於「倍數 × 上一根的 ATR」就不做。預設 0.95（NQ 2m 回測 0.9–1.1 結果都一樣）。所有商品共用")
qNqOn     = input.bool(true, "QQQ / NQ RTH：NQ 2 分 K 不反向", group=grpR, inline="qnq")
nqSym     = input.symbol("CME_MINI:NQ1!", "", group=grpR, inline="qnq", tooltip="只影響 QQQ 和 NQ RTH：上一根已收完的 NQ 2 分 K（24 小時盤）Trend Judge 跟訊號反向就不做。讀不到 NQ 時不擋")
d5On      = input.bool(true, "NQ 5m：不逆日線 SMA5（趨勢和 MIX）", group=grpR, tooltip="只在 NQ / MNQ 5 分 K：日 K（CME 交易日）SMA5 用前 5 個完整交易日的收盤（今天不算），買要在 SMA5 上方、賣要在下方；趨勢訊號看訊號 K 收盤，MIX 突破看突破價。回測 NQ 5m 五年每一年都比較好（前四年每年少虧 8–37R，v3 那年 +84R → +91R、勝率 45% → 54%）；2m 沒有一致的幫助，所以只用在 5m")
d5Near    = input.float(0.25, "NQ 5m：MIX 突破價離 SMA5 至少（%）", minval=0, step=0.05, group=grpR, tooltip="只在 NQ / MNQ 5 分 K、MIX 突破：突破價離日 K SMA5 不到這個 %（價格的百分比）就不做，0 = 關。回測（每筆單獨算）：離 SMA5 0.25% 以內的 5m MIX 兩段期間都是最差的一組（v3 那年 2R 命中 39%、+0.25R，其他 44–55%；前 4 年 −0.28R），拿掉後 v3 那年少約 7R、前 4 年每年少虧約 8R，勝率提高")

// ═════════════════ 6. 不交易的時間（趨勢訊號和 MIX 共用）═════════════════
grpN      = "不交易的時間（趨勢訊號和 MIX 共用）"
avoidEvt  = input.bool(true, "避開數據、開收盤、Globex 時段", group=grpN, tooltip="美東時間，看 K 棒收盤：平日 08:28–09:00、09:58–10:15；每天 09:30–10:00、15:45–16:15、16:45–17:00、18:00–18:30；FOMC 日 13:58–15:00")
junkOn    = input.bool(true, "垃圾時間：美東", group=grpN, inline="junk")
junkH1    = input.int(12, "", minval=0, maxval=23, group=grpN, inline="junk")
junkM1    = input.int(0, ":", minval=0, maxval=59, group=grpN, inline="junk")
junkH2    = input.int(13, "到", minval=0, maxval=23, group=grpN, inline="junk")
junkM2    = input.int(5, ":", minval=0, maxval=59, group=grpN, inline="junk", tooltip="這段時間（美東，看 K 棒收盤，含頭尾；預設 12:00–13:05 = 台灣 00:00–01:05）趨勢訊號和 MIX 都不做（MIX 碰到突破價區間作廢，同事件時段），持倉照常出場。所有商品適用")
pmAvoid   = input.bool(true, "收盤後避開：美東 15:45–18:30（台灣 03:45–06:30）", group=grpN, tooltip="NQ / ES：K 棒收盤在美東 15:45–18:30（台灣 03:45–06:30）不發新訊號（趨勢、MIX、再進場），持倉照常出場。v3 原本就避開其中的收盤前後、休市前、休市、Globex 開盤，這條多擋掉美東 16:15–16:45 的單。回測 NQ 2m v3 那年 +204R → +209R（一年約擋掉 23 筆，勝率 29%），前 4 年每年 0～−9R；5m 幾乎沒差（2026-10-21 Remi 決定）")
fomcDay   = input.bool(true, "FOMC 當天整天不做", group=grpN, tooltip="FOMC 利率決議當天（美東日期，用下面的清單）趨勢訊號和 MIX 都不做，持倉照常出場。回測 NQ 2m 五年每一年都改善（+1～+11R）；5m 大約持平")
fomcDates = input.string("2025-10-29,2025-12-10,2026-01-28,2026-03-18,2026-04-29,2026-06-17,2026-07-29,2026-09-16,2026-10-28,2026-12-09", "FOMC 日期", group=grpN, tooltip="利率決議公布日（美東），逗號分開。回測更早的期間，要把那段時間的 FOMC 日期加進來；2027 年還沒加")
friCut    = input.bool(true, "週五：台灣時間週六", group=grpN, inline="fri")
friCutH   = input.int(2, "", minval=0, maxval=6, group=grpN, inline="fri")
friCutM   = input.int(0, "點　分以後不開新倉", minval=0, maxval=59, group=grpN, inline="fri", tooltip="預設 02:00 = 美東週五 14:00。已經在持倉中的照常出場")

// ═════════════════ 7. MIX 區間突破（NQ 2、5 分 K）═════════════════
grpM      = "MIX 區間突破（NQ 2、5 分 K）"
mixPmOff  = input.bool(true, "不做美東 16–20（收盤後）", group=grpM, tooltip="K 棒收盤在美東 16:00–20:00（台灣時間 04:00–08:00）不掛 MIX 突破單；碰到突破價區間照樣作廢")
mixClose  = input.bool(false, "等收線才進場（目標 2R）", group=grpM, tooltip="關（預設）：在突破價掛停損單，碰到就成交，目標同週期（2 分 K 3R、5 分 K 2R）。開：K 棒收在突破價外才在那根收盤市價進場，目標 2R，停損一樣在中線；只碰到、沒收出去不算，區間繼續有效。回測一年：2 分 K +166R → +146R；5 分 K +90R → +83R")

// ═════════════════ 8. 持倉和出場 ═════════════════
grpO      = "持倉和出場"
holdBars  = input.int(60, "最多持有幾根 K", minval=1, group=grpO, tooltip="停損和目標都沒碰到，持有這麼多根 K 後收盤平倉（回測都是 60 根）")
flatHalt  = input.bool(true, "NQ / ES 在美東 17:00 休市前平倉", group=grpO, tooltip="美東 17:00 收盤那根 K 平倉，也不讓 MIX 突破單掛過休市。假日提早收盤不會自動處理")
reOn      = input.bool(true, "NQ 2m：停損後再進場一次", group=grpO, tooltip="只在 NQ / MNQ 2 分 K：趨勢單或 MIX 單停損出場後 5 根 K 內，Trend Judge 還在同方向、收盤收回原進場價之外，就同方向收盤市價再進場一次（訂單代號 R L / R S），停損在那根和前一根的極值（要 ≥ 停損 ATR 倍數），目標 3R。事件時段、垃圾時間、FOMC 日、週五截止後不做；再進場的單停損後不會再進。同指標版")

// ═════════════════ 9. 線和表格 ═════════════════
grpA      = "線和表格"
showPos   = input.bool(true, "畫出持倉的停損和目標", group=grpA, inline="ps")
stopCol   = input.color(#F23645, "", group=grpA, inline="ps")
tgtCol    = input.color(#36FE02, "", group=grpA, inline="ps")
showBox   = input.bool(true, "畫出 MIX 區間", group=grpA, inline="bx")
boxCol    = input.color(color.new(#9598A1, 85), "", group=grpA, inline="bx")
boxLnCol  = input.color(#9598A1, "線", group=grpA, inline="bx")
showTbl   = input.bool(true, "顯示狀態表格", group=grpA, inline="tbl")
tblPos    = input.string("左下", "", options=["左下", "右下", "左上", "右上"], group=grpA, inline="tbl")

// ═════════════════ 10. 訊號參數 ═════════════════
grpS      = "訊號參數（階段、Ema number）"
sigMode   = input.string("自動（依商品）", "訊號", options=["自動（依商品）", "自訂"], group=grpS, tooltip="自動：NQ / ES / TXF 用 (20, 0, 8, 1)，QQQ / SPY / NQ RTH 用 (35, 0, 8, 1)。自訂：所有商品都改用下面這一列（沒有回測過）")
v3Stage   = input.int(20, "自訂　階段", minval=2, group=grpS, inline="v3s")
v3Ema     = input.int(8, "Ema number", minval=1, group=grpS, inline="v3s")

// ═════════════════ 11. Trend Judge ═════════════════
grpT      = "Trend Judge（門檻依商品自動）"
tjCalc    = input.string("1 分 K 推算（同回測）", "算法", options=["1 分 K 推算（同回測）", "圖表 K 棒推算"], group=grpT, tooltip="門檻（一般 / 強勢）：NQ 10 / 35、NQ RTH 20 / 40、ES 4 / 8、TXF 30 / 60、QQQ 0.5 / 1、SPY 0.8 / 1.6")
tjEmaLen  = input.int(1130, "EMA 長度", minval=1, group=grpT)
tjFastS   = input.int(5, "快線秒數", minval=1, group=grpT, inline="tjs")
tjSlowS   = input.int(15, "慢線秒數", minval=1, group=grpT, inline="tjs")

// ═════════════════ 商品和週期 → 做法（同 v3）═════════════════
string root     = syminfo.root != "" ? syminfo.root : syminfo.ticker
bool   autoTX   = str.contains(root, "TXF") or str.contains(root, "MXF") or str.contains(root, "TMF")
int  barEtMin  = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
var int lastNight = na
if barEtMin < 570 or barEtMin >= 975
    lastNight := bar_index
// 只看 K 棒（不看 syminfo.session：期貨切 RTH 時 TradingView 回報的時段類型不一定是 regular）：
// 已經有 1500 根 K，而且最近 1500 根都沒有美東 09:30–16:15 以外的 K 棒（24 小時盤的 NQ 每天都有夜盤 K）
bool   chartRth = timeframe.isintraday and bar_index >= 1500 and (na(lastNight) or bar_index - lastNight > 1500)
string autoProf = str.contains(root, "NQ") ? (chartRth ? "NQ RTH" : "NQ") : autoTX ? "TXF" : root == "QQQ" ? "QQQ" : root == "SPY" ? "SPY" : str.contains(root, "ES") ? "ES" : "無"
string prof     = profSel == "自動" ? autoProf : profSel == "NQ RTH（代替 QQQ）" ? "NQ RTH" : profSel
bool   isNqR    = prof == "NQ RTH"
bool   isNQ     = prof == "NQ"
bool   isES     = prof == "ES"
bool   isTX     = prof == "TXF"
bool   isQQ     = prof == "QQQ"
bool   isSP     = prof == "SPY"
bool   isETF    = isQQ or isSP or isNqR
bool   isStock  = isQQ or isSP
bool   isCME    = isNQ or isES
string tfp      = timeframe.period
bool   okTf     = isNQ ? (tfp == "2" or tfp == "3" or tfp == "5") : (isTX or isES) ? (tfp == "2" or tfp == "3") : isETF ? tfp == "1" : false
bool   profOn   = isES ? esOn : (isNQ or isTX or isETF)
bool   active   = profOn and (okTf or otherTf)
bool   nq3      = isNQ and tfp == "3"
bool   nq5      = isNQ and tfp == "5"
bool   sigCust  = sigMode == "自訂"
int    stageUse = sigCust ? v3Stage : isETF ? 35 : 20
int    emaUse   = sigCust ? v3Ema : 8
float  thU      = isNQ ? 10.0 : isES ? 4.0 : isTX ? 30.0 : isQQ ? 0.5 : isSP ? 0.8 : isNqR ? 20.0 : na
float  stU      = isNQ ? 35.0 : isES ? 8.0 : isTX ? 60.0 : isQQ ? 1.0 : isSP ? 1.6 : isNqR ? 40.0 : na
float  distU    = isETF ? 7.0 : 3.0
bool   useWin   = not isETF
int    winLo    = nq3 ? 90 : isTX ? 60 : 0
int    winHi    = nq3 ? 120 : isTX ? 120 : isNQ and tfp == "2" ? 400 : 180   // NQ 2m 2026-10-21 從 180 放寬到 400（trend_cap.py）
bool   mixUse   = isNQ and not nq3
float  tgtR     = nq3 ? 1.0 : nq5 ? 2.0 : 3.0
int    qtyUse   = isStock ? qtyEtf : qtyFut
bool   splitOn  = exitMode != "全部照目標"
int    qtyIn    = splitOn ? 2 * qtyUse : qtyUse                 // 兩組時每筆進「口數 × 2」
string gradeTxt = not profOn and isES ? "不建議" : prof == "無" ? "不支援" : not okTf ? "不是建議週期" : isNQ and tfp == "2" ? "主力" : isTX ? "邊緣" : "可做"

// ═════════════════ 原版買賣訊號 ═════════════════
bool newLow  = low < ta.lowest(low, stageUse)[1]
bool newHigh = high > ta.highest(high, stageUse)[1]
var float refHigh = na
var float refLow  = na
var bool  armBuy  = false
var bool  armSell = false
float sigEma  = ta.ema(close, emaUse)
bool trigBuy  = armBuy and close > refHigh
bool trigSell = armSell and close < refLow
if trigBuy
    armBuy := false
else if newLow
    refHigh := high
    armBuy  := true
if trigSell
    armSell := false
else if newHigh
    refLow  := low
    armSell := true
bool buySig  = trigBuy and close > sigEma
bool sellSig = trigSell and close < sigEma

// ═════════════════ Trend Judge（1 分 K 推算）═════════════════
float tfSec    = timeframe.in_seconds()
float tjAFast1 = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 60.0 / tjFastS)
float tjASlow1 = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 60.0 / tjSlowS)
float tjAFastB = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), tfSec / tjFastS)
float tjASlowB = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), tfSec / tjSlowS)
tjMinArr = request.security_lower_tf(syminfo.tickerid, "1", close)
var float tjMaFast = na
var float tjMaSlow = na
int  tjMinN = array.size(tjMinArr)
bool tjBy1m = tjCalc == "1 分 K 推算（同回測）" and tjMinN > 0 and tfSec > 60
if tjBy1m
    for k = 0 to tjMinN - 1
        float mc = array.get(tjMinArr, k)
        if not na(mc)
            tjMaFast := na(tjMaFast) ? mc : tjMaFast + tjAFast1 * (mc - tjMaFast)
            tjMaSlow := na(tjMaSlow) ? mc : tjMaSlow + tjASlow1 * (mc - tjMaSlow)
else
    tjMaFast := na(tjMaFast) ? close : tjMaFast + tjAFastB * (close - tjMaFast)
    tjMaSlow := na(tjMaSlow) ? close : tjMaSlow + tjASlowB * (close - tjMaSlow)
var float tjDiff = na
bool tjNewWin = ta.change(time("2")) != 0
if tjNewWin and not na(tjMaFast) and not na(tjMaSlow)
    tjDiff := tjMaFast - tjMaSlow
int  tjDirI   = na(tjDiff) or na(thU) ? 0 : tjDiff > stU ? 2 : tjDiff > thU ? 1 : tjDiff < -stU ? -2 : tjDiff < -thU ? -1 : 0
bool tjLinked = not na(tjDiff) and not na(thU)

var int trendBars = 0
int trendDir = tjLinked ? (tjDirI > 0 ? 1 : tjDirI < 0 ? -1 : 0) : 0
if trendDir != 0 and trendDir == nz(trendDir[1])
    trendBars += 1
else
    trendBars := trendDir != 0 ? 1 : 0
float trendMin = trendBars * tfSec / 60.0
bool  inWin    = not useWin or (trendMin >= winLo and trendMin < winHi)

// ═════════════════ 時段（看 K 棒收盤時間；MIX 掛單看下一根）═════════════════
evtAt(int tc) =>
    int  m  = hour(tc, "America/New_York") * 60 + minute(tc, "America/New_York")
    int  dw = dayofweek(tc, "America/New_York")
    bool wk = dw >= dayofweek.monday and dw <= dayofweek.friday
    bool fo = str.contains(fomcDates, str.format_time(tc, "yyyy-MM-dd", "America/New_York"))
    (wk and ((m >= 508 and m < 540) or (m >= 598 and m < 615))) or (fo and m >= 838 and m < 900) or (m >= 570 and m < 600) or (m >= 945 and m < 975) or (m >= 1005 and m < 1020) or (m >= 1080 and m < 1110)
junkAt(int tc) =>
    int m = hour(tc, "America/New_York") * 60 + minute(tc, "America/New_York")
    junkOn and m >= junkH1 * 60 + junkM1 and m <= junkH2 * 60 + junkM2
pmAt(int tc) =>
    int m = hour(tc, "America/New_York") * 60 + minute(tc, "America/New_York")
    pmAvoid and m >= 945 and m < 1110
friAt(int tc) =>
    int tw = hour(tc, "Asia/Taipei") * 60 + minute(tc, "Asia/Taipei")
    friCut and dayofweek(tc, "Asia/Taipei") == dayofweek.saturday and tw >= friCutH * 60 + friCutM
int  tfMs    = timeframe.in_seconds() * 1000
int  tClose  = na(time_close) ? time + tfMs : time_close
int  tNext   = tClose + tfMs
int  etMin   = hour(tClose, "America/New_York") * 60 + minute(tClose, "America/New_York")
int  etMinN  = hour(tNext, "America/New_York") * 60 + minute(tNext, "America/New_York")
int  twMin   = hour(tClose, "Asia/Taipei") * 60 + minute(tClose, "Asia/Taipei")
bool evtNow  = (avoidEvt and evtAt(tClose)) or junkAt(tClose) or (isCME and pmAt(tClose))     // 事件時段、垃圾時間、收盤後 15:45–18:30
bool evtNext = (avoidEvt and evtAt(tNext)) or junkAt(tNext) or (isCME and pmAt(tNext))
bool haltBar = flatHalt and isCME and etMin == 1020
bool haltNxt = flatHalt and isCME and etMinN == 1020
bool pmNext  = mixPmOff and etMinN >= 960 and etMinN < 1200
bool pmNow   = mixPmOff and etMin >= 960 and etMin < 1200
bool friLate = friAt(tClose)
bool fomcSkip = fomcDay and str.contains(fomcDates, str.format_time(tClose, "yyyy-MM-dd", "America/New_York"))
bool fomcNext = fomcDay and str.contains(fomcDates, str.format_time(tNext, "yyyy-MM-dd", "America/New_York"))
bool friNext = friAt(tNext)
// 每段交易時間的最後一根：TXF 日盤 13:45、夜盤 05:00（台灣時間）；QQQ / SPY / NQ RTH 美東 16:00
bool sessEnd = isTX ? (twMin == 825 or twMin == 300 or session.islastbar) : isETF ? (etMin >= 960 or session.islastbar) : false
bool mbHole  = not na(time[1]) and time - time[1] > 30 * 60 * 1000

// ═════════════════ NQ 2 分 K 的 Trend Judge（QQQ、NQ RTH 用）═════════════════
nqTJ() =>
    float aF = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 120.0 / tjFastS)
    float aS = 1 - math.pow(1 - 2.0 / (tjEmaLen + 1), 120.0 / tjSlowS)
    var float ef = na
    var float es = na
    ef := na(ef) ? close : ef + aF * (close - ef)
    es := na(es) ? close : es + aS * (close - es)
    float dd = ef - es
    int dir = dd > 35 ? 2 : dd > 10 ? 1 : dd < -35 ? -2 : dd < -10 ? -1 : 0
    dir[1]
int nqDir = request.security(ticker.modify(nqSym, session.extended), "2", nqTJ(), lookahead=barmerge.lookahead_on)
bool qNqUse   = (isQQ or isNqR) and qNqOn
bool nqBuyOk  = not qNqUse or na(nqDir) or nqDir >= 0
bool nqSellOk = not qNqUse or na(nqDir) or nqDir <= 0

// ═════════════════ GEX setup（NQ RTH）：(35, 0, 8, 1) + Trend Judge 順勢 + 朝 QQQ gamma flip 走（同指標版）═════════════════
float qqqPx    = isQQ ? close : request.security(qqqSym, timeframe.period, close)
bool  gsActive = gsOn and isNqR and (tfp == "1" or otherTf)
bool  gsReady  = gexFlip > 0 and not na(qqqPx)
bool  gNewLow  = low < ta.lowest(low, gsStage)[1]
bool  gNewHigh = high > ta.highest(high, gsStage)[1]
var float gRefHigh = na
var float gRefLow  = na
var bool  gArmBuy  = false
var bool  gArmSell = false
float gEma      = ta.ema(close, gsEma)
bool  gTrigBuy  = gArmBuy and close > gRefHigh
bool  gTrigSell = gArmSell and close < gRefLow
if gTrigBuy
    gArmBuy := false
else if gNewLow
    gRefHigh := high
    gArmBuy  := true
if gTrigSell
    gArmSell := false
else if gNewHigh
    gRefLow  := low
    gArmSell := true
bool gsEnd   = etMin >= 960 or session.islastbar
bool junkNow = junkAt(tClose)
bool gsBuy   = gsActive and gsReady and gTrigBuy and close > gEma and tjLinked and tjDirI >= 1 and qqqPx < gexFlip and not friLate and not gsEnd and not junkNow
// 開盤高開低走（NQ RTH）：高開 ≥ goGap%，第一根 2 分鐘收黑還在昨收之上
var float goPrevC = na
var float goLastC = na
var float goO     = na
var float goH     = na
if etMin == 960
    goLastC := close
if barEtMin == 570
    goPrevC := goLastC
    goO     := open
    goH     := high
else if barEtMin == 571
    goH := math.max(goH, high)
float goGapP = na(goPrevC) or na(goO) ? na : (goO - goPrevC) / goPrevC * 100
bool  goSig  = goOn and isNqR and (tfp == "1" or tfp == "2") and etMin == 572 and not na(goGapP) and goGapP >= goGap and close < goO and close > goPrevC
bool gsSell  = gsActive and gsReady and gTrigSell and close < gEma and tjLinked and tjDirI <= -1 and qqqPx > gexFlip and not friLate and not gsEnd and (not junkNow or gsJunkSell)

// ═════════════════ 趨勢訊號 ═════════════════
h1Vals() =>
    float h1e = ta.ema(close, h1Len)
    [close[1], h1e[1]]
[h1Close, h1Ema] = request.security(syminfo.tickerid, "60", h1Vals(), lookahead=barmerge.lookahead_on)
float atrPrev  = ta.atr(atrLen)[1]
float atrNow   = ta.atr(atrLen)
// NQ 5m：日 K SMA5（前 5 個完整交易日，今天不算），買要在上方、賣要在下方
float d5    = request.security(syminfo.tickerid, "D", ta.sma(close, 5)[1], lookahead=barmerge.lookahead_on)
bool  d5Use = d5On and nq5 and not na(d5)
// 5m MIX：突破價要離 SMA5 至少 d5Near%
farD5(float px) =>
    not d5Use or d5Near <= 0 or math.abs(px - d5) / px * 100 >= d5Near
float buyStop  = math.min(low, low[1])
float sellStop = math.max(high, high[1])
bool trBuy  = active and useTrend and buySig and tjLinked and tjDirI >= 1 and not na(h1Ema) and h1Close > h1Ema and not na(atrPrev) and close - buyStop >= riskMult * atrPrev and not na(tjMaSlow) and close - tjMaSlow <= distU * atrNow and not evtNow and inWin and nqBuyOk and not friLate and not fomcSkip and (not d5Use or close > d5)
bool trSell = active and useTrend and sellSig and tjLinked and tjDirI <= -1 and not na(h1Ema) and h1Close < h1Ema and not na(atrPrev) and sellStop - close >= riskMult * atrPrev and not na(tjMaSlow) and tjMaSlow - close <= distU * atrNow and not evtNow and inWin and nqSellOk and not friLate and not fomcSkip and (not d5Use or close < d5)

// ═════════════════ MIX 區間（只有 NQ 2、5 分 K）═════════════════
float tfMin   = tfSec / 60.0
int   mbNeed  = math.max(1, math.round(60 / tfMin))
int   mbGrace = math.max(0, math.round(4 / tfMin))
int   mbLife  = math.max(1, math.round(60 / tfMin))
bool  isMix   = tjLinked and tjDirI == 0
var int   mbStart  = na
var int   mbRun    = 0
var float mbHi     = na
var float mbLo     = na
var bool  mbFormed = false
if mbHole
    mbStart := na
    mbRun   := 0
if isMix
    if na(mbStart)
        mbStart  := bar_index
        mbHi     := high
        mbLo     := low
        mbFormed := false
    else
        mbHi := math.max(mbHi, high)
        mbLo := math.min(mbLo, low)
    mbRun := 0
else if not na(mbStart)
    if tjLinked and tjDirI != 0
        mbRun += 1
        if mbRun > mbGrace
            mbStart := na
            mbRun   := 0
        else
            mbHi := math.max(mbHi, high)
            mbLo := math.min(mbLo, low)
    else
        mbStart := na
        mbRun   := 0
var float bxTop  = na
var float bxBot  = na
var int   bxLeft = na
var int   bxForm = na
var int   bxEnd  = na
var bool  bxLive = false
bool mbForm = false
if not na(mbStart) and not mbFormed and bar_index - mbStart + 1 >= mbNeed
    mbFormed := true
    mbForm   := true
    bxTop    := mbHi
    bxBot    := mbLo
    bxLeft   := mbStart
    bxForm   := bar_index
    bxEnd    := bar_index + mbLife
    bxLive   := mbHi > mbLo
float bxH   = bxTop - bxBot
float bxUpL = bxTop + 0.1 * bxH
float bxDnL = bxBot - 0.1 * bxH
float bxMid = (bxTop + bxBot) / 2
float mixTgtR = mixClose ? 2.0 : tgtR
float bxUpT = bxUpL + mixTgtR * (bxUpL - bxMid)
float bxDnT = bxDnL - mixTgtR * (bxMid - bxDnL)
// 掛單進場：第一次碰到突破價（不論有沒有成交）區間就作廢
// 等收線進場：K 棒收在突破價外才算突破（不在事件時段、美東 16–20 才做），區間作廢；只碰到不算
bool mxUpC = false
bool mxDnC = false
if bxLive and not mbForm and bar_index > bxForm
    if bar_index > bxEnd or mbHole
        bxLive := false
    else if mixClose
        if close > bxUpL or close < bxDnL
            bxLive := false
            if not evtNow and not pmNow and not fomcSkip
                mxUpC := close > bxUpL and (not d5Use or bxUpL > d5) and farD5(bxUpL)
                mxDnC := close < bxDnL and (not d5Use or bxDnL < d5) and farD5(bxDnL)
    else if high >= bxUpL or low <= bxDnL
        bxLive := false
var line bxUpLine = na
var line bxDnLine = na
if active and mixUse and useMix and mbForm and bxLive and showBox and not na(bxTop) and not na(bxBot)
    box.new(bxLeft, bxTop, bar_index, bxBot, border_color=boxLnCol, bgcolor=boxCol)
    int lineEnd = bar_index + math.min(mbLife, 500)
    bxUpLine := line.new(bar_index, bxUpL, lineEnd, bxUpL, color=boxLnCol, style=line.style_dashed)
    bxDnLine := line.new(bar_index, bxDnL, lineEnd, bxDnL, color=boxLnCol, style=line.style_dashed)

// ═════════════════ 下單 ═════════════════
// 快訊訊息（JSON），自動下單（autotrade/）讀這個：tf 是圖表週期（2、5 分共用一個倉位，靠它分辨是哪張圖的單），contract 是連續合約（NQ1!）目前對應的合約月份，price 是預期進場價，tv_time 是快訊觸發時間（量延遲用）
string ccTxt = na(syminfo.current_contract) ? syminfo.ticker : syminfo.current_contract
msgHead(string act) =>
    '{"strategy":"Remi Superb v3","ticker":"' + syminfo.ticker + '","contract":"' + ccTxt + '","tf":"' + timeframe.period + '","action":"' + act + '","tv_time":"{{timenow}}"'
entryMsg(string act, string why, float px, float stp, float tgt) =>
    msgHead(act) + ',"qty":' + str.tostring(qtyIn) + ',"signal":"' + why + '","price":' + str.tostring(px, format.mintick) + ',"stop":' + str.tostring(stp, format.mintick) + ',"target":' + str.tostring(tgt, format.mintick) + '}'
string exitMsg = msgHead("exit") + '}'
string partMsg = msgHead("partial") + ',"qty":' + str.tostring(qtyUse) + '}'
// 出場：全部照目標；或兩組（第一組 1R、第二組照原停損和目標）
placeExits(string eid, float stp, float ent, float tgt) =>
    if splitOn
        strategy.exit(eid + " x1", eid, qty=qtyUse, stop=stp, limit=ent + (ent - stp), comment_loss="停損", comment_profit="1R", alert_message=partMsg)
        strategy.exit(eid + " x2", eid, qty=qtyUse, stop=stp, limit=tgt, comment_loss="停損", comment_profit="目標", alert_message=exitMsg)
    else
        strategy.exit(eid + " x", eid, stop=stp, limit=tgt, comment_loss="停損", comment_profit="目標", alert_message=exitMsg)

var float posStop = na
var float posTgt  = na
bool flat = strategy.position_size == 0

// 剛成交的 MIX 突破單：記下它的停損和目標（畫線用）
if not flat and nz(strategy.position_size[1]) == 0 and not mixClose
    string eid = strategy.opentrades.entry_id(0)
    if eid == "M L"
        posStop := bxMid
        posTgt  := bxUpT
    else if eid == "M S"
        posStop := bxMid
        posTgt  := bxDnT

// 時間出場、休市前 / 收盤平倉、資料中斷（收盤）
bool timeUp = false
if not flat
    int held = bar_index - strategy.opentrades.entry_bar_index(0)
    timeUp := held >= holdBars or haltBar or sessEnd or mbHole
    if timeUp
        strategy.close_all(comment=held >= holdBars ? "時間出場" : haltBar ? "休市前平倉" : sessEnd ? "收盤平倉" : "資料中斷", alert_message=exitMsg)

bool canEnter = flat and not haltBar and not sessEnd

// 停損後再進場（只有 NQ 2m）：剛停損出場的趨勢 / MIX 單，5 根內 Trend Judge 同方向、收盤收回原進場價之外，就同方向再進一次
bool reUse = reOn and isNQ and tfp == "2"
var int   reSide  = 0
var float reEntry = na
var int   reUntil = na
if strategy.closedtrades > nz(strategy.closedtrades[1])
    int    ctN  = strategy.closedtrades - 1
    string ceid = strategy.closedtrades.entry_id(ctN)
    bool   cStp = strategy.closedtrades.exit_comment(ctN) == "停損"
    reSide  := cStp and ceid != "R L" and ceid != "R S" and ceid != "G L" and ceid != "G S" ? (strategy.closedtrades.size(ctN) > 0 ? 1 : -1) : 0
    reEntry := strategy.closedtrades.entry_price(ctN)
    reUntil := bar_index + 5
if mbHole or (reSide != 0 and (bar_index > reUntil or (tjLinked and trendDir == -reSide)))
    reSide := 0
float reStop  = reSide == 1 ? math.min(low, low[1]) : reSide == -1 ? math.max(high, high[1]) : na
bool  reReady = reUse and active and useTrend and canEnter and reSide != 0 and tjLinked and trendDir == reSide and (close - reEntry) * reSide > 0 and not evtNow and not fomcSkip and not friLate
bool  goReL   = reReady and reSide == 1 and close - reStop >= riskMult * atrPrev
bool  goReS   = reReady and reSide == -1 and reStop - close >= riskMult * atrPrev
if reReady
    reSide := 0
if goReL
    float tgtRL = close + tgtR * (close - reStop)
    strategy.cancel("M L")
    strategy.cancel("M S")
    strategy.entry("R L", strategy.long, qty=qtyIn, comment="再進場買", alert_message=entryMsg("buy", "再進場", close, reStop, tgtRL))
    placeExits("R L", reStop, close, tgtRL)
    posStop := reStop
    posTgt  := tgtRL
if goReS
    float tgtRS = close - tgtR * (reStop - close)
    strategy.cancel("M L")
    strategy.cancel("M S")
    strategy.entry("R S", strategy.short, qty=qtyIn, comment="再進場賣", alert_message=entryMsg("sell", "再進場", close, reStop, tgtRS))
    placeExits("R S", reStop, close, tgtRS)
    posStop := reStop
    posTgt  := tgtRS
bool reGo = goReL or goReS

// MIX 等收線進場：K 棒收在突破價外，這根收盤市價進場，目標 2R（訂單代號跟掛單版分開，下面取消掛單時不會取消到）
bool goMixL = mixClose and active and mixUse and useMix and canEnter and mxUpC and not friLate and not reGo
bool goMixS = mixClose and active and mixUse and useMix and canEnter and mxDnC and not friLate and not goMixL and not reGo
if goMixL
    float tgtML = close + mixTgtR * (close - bxMid)
    strategy.entry("MC L", strategy.long, qty=qtyIn, comment="MIX 上破（收線）", alert_message=entryMsg("buy", "MIX 突破", close, bxMid, tgtML))
    placeExits("MC L", bxMid, close, tgtML)
    posStop := bxMid
    posTgt  := tgtML
if goMixS
    float tgtMS = close - mixTgtR * (bxMid - close)
    strategy.entry("MC S", strategy.short, qty=qtyIn, comment="MIX 下破（收線）", alert_message=entryMsg("sell", "MIX 突破", close, bxMid, tgtMS))
    placeExits("MC S", bxMid, close, tgtMS)
    posStop := bxMid
    posTgt  := tgtMS

// 趨勢訊號：這根收盤市價進場
bool goLong   = canEnter and trBuy and not goMixL and not goMixS and not reGo
bool goShort  = canEnter and trSell and not goLong and not goMixL and not goMixS and not reGo
if goLong
    float tgtL = close + tgtR * (close - buyStop)
    strategy.cancel("M L")
    strategy.cancel("M S")
    strategy.entry("T L", strategy.long, qty=qtyIn, comment="趨勢買", alert_message=entryMsg("buy", "趨勢", close, buyStop, tgtL))
    placeExits("T L", buyStop, close, tgtL)
    posStop := buyStop
    posTgt  := tgtL
if goShort
    float tgtS = close - tgtR * (sellStop - close)
    strategy.cancel("M L")
    strategy.cancel("M S")
    strategy.entry("T S", strategy.short, qty=qtyIn, comment="趨勢賣", alert_message=entryMsg("sell", "趨勢", close, sellStop, tgtS))
    placeExits("T S", sellStop, close, tgtS)
    posStop := sellStop
    posTgt  := tgtS

// GEX setup：空手、這根 v3 沒有單時，收盤市價進場
bool goGsL = canEnter and gsBuy and not reGo and not goLong and not goShort and not goMixL and not goMixS
bool goGsS = canEnter and gsSell and not reGo and not goGsL and not goLong and not goShort and not goMixL and not goMixS
if goGsL
    float tgtGL = close + 3.0 * (close - buyStop)
    strategy.entry("G L", strategy.long, qty=qtyIn, comment="GEX 買", alert_message=entryMsg("buy", "GEX setup", close, buyStop, tgtGL))
    placeExits("G L", buyStop, close, tgtGL)
    posStop := buyStop
    posTgt  := tgtGL
if goGsS
    float tgtGS = close - 3.0 * (sellStop - close)
    strategy.entry("G S", strategy.short, qty=qtyIn, comment="GEX 賣", alert_message=entryMsg("sell", "GEX setup", close, sellStop, tgtGS))
    placeExits("G S", sellStop, close, tgtGS)
    posStop := sellStop
    posTgt  := tgtGS

// 開盤高開低走：空手、這根沒有其他單時，收盤市價做空
bool goOS = canEnter and goSig and not reGo and not goLong and not goShort and not goMixL and not goMixS and not goGsL and not goGsS
if goOS
    float goStp = goH + syminfo.mintick
    float goTg  = close - goR * (goStp - close)
    strategy.entry("O S", strategy.short, qty=qtyIn, comment="高開低走賣", alert_message=entryMsg("sell", "開盤高開低走", close, goStp, goTg))
    placeExits("O S", goStp, close, goTg)
    posStop := goStp
    posTgt  := goTg

// MIX 突破：區間有效、空手，而且下一根不在事件時段、美東 16–20、休市那根、週五截止後，才在上下突破價掛停損單
bool mixArm = not mixClose and active and mixUse and useMix and canEnter and not reGo and not goLong and not goShort and bxLive and bar_index >= bxForm and bar_index < bxEnd and not evtNext and not pmNext and not haltNxt and not friNext and not friLate and not fomcNext
if mixArm
    bool mlOk = (not d5Use or bxUpL > d5) and farD5(bxUpL)                                 // 5m 不逆日線 SMA5：只掛順日線那一邊
    bool msOk = (not d5Use or bxDnL < d5) and farD5(bxDnL)
    if mlOk
        strategy.entry("M L", strategy.long, qty=qtyIn, stop=bxUpL, oca_name="MIX", oca_type=strategy.oca.cancel, comment="MIX 上破", alert_message=entryMsg("buy", "MIX 突破", bxUpL, bxMid, bxUpT))
        placeExits("M L", bxMid, bxUpL, bxUpT)
    else
        strategy.cancel("M L")
    if msOk
        strategy.entry("M S", strategy.short, qty=qtyIn, stop=bxDnL, oca_name="MIX", oca_type=strategy.oca.cancel, comment="MIX 下破", alert_message=entryMsg("sell", "MIX 突破", bxDnL, bxMid, bxDnT))
        placeExits("M S", bxMid, bxDnL, bxDnT)
    else
        strategy.cancel("M S")
else
    strategy.cancel("M L")
    strategy.cancel("M S")

bool showLines = showPos and not flat and not timeUp
plot(showLines ? posStop : na, "停損", color=stopCol, style=plot.style_linebr)
plot(showLines ? posTgt : na, "目標", color=tgtCol, style=plot.style_linebr)
plot(tjDiff, "TJ 差值", display=display.data_window)
plot(trendMin, "趨勢已持續（分鐘）", display=display.data_window)

// ═════════════════ 狀態表格 ═════════════════
tblWhere = tblPos == "左上" ? position.top_left : tblPos == "右上" ? position.top_right : tblPos == "左下" ? position.bottom_left : position.bottom_right
var table st = table.new(tblWhere, 2, 4, border_width=1)
addRow(int r, string lbl, string val, color vb) =>
    table.cell(st, 0, r, lbl, text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.tiny)
    table.cell(st, 1, r, val, text_color=color.white, bgcolor=vb, text_size=size.tiny, text_halign=text.align_center)
if barstate.islast and showTbl
    table.clear(st, 0, 0, 1, 3)
    color setCol = gradeTxt == "主力" ? color.new(#2962FF, 30) : gradeTxt == "可做" ? color.new(#2962FF, 55) : gradeTxt == "邊緣" ? color.new(color.orange, 40) : color.new(color.red, 30)
    addRow(0, "設定", prof == "無" ? "不支援 " + syminfo.ticker : prof + " " + tfp + "m " + gradeTxt + "（" + str.tostring(tgtR) + "R）", setCol)
    string tjTxt = not tjLinked ? "沒有資料" : tjDirI == 2 ? "強UP" : tjDirI == 1 ? "UP" : tjDirI == -2 ? "強Down" : tjDirI == -1 ? "DOWN" : "MIX"
    color  tjCol = not tjLinked ? color.gray : tjDirI == 2 ? color.lime : tjDirI == 1 ? color.green : tjDirI == -2 ? color.maroon : tjDirI == -1 ? color.red : color.orange
    addRow(1, "趨勢", tjTxt + (trendDir != 0 ? " " + str.tostring(trendMin, "#") + "分" + (useWin and inWin ? " ✅" : "") : ""), tjCol)
    addRow(2, "下單", (isStock ? str.tostring(qtyEtf) + " 股" : str.tostring(qtyFut) + " 口") + (splitOn ? " × 2 組（1R 先出一組）" : "") + (mixUse and useMix ? "，趨勢 + MIX" + (mixClose ? "（收線 2R）" : "") : "，趨勢") + (gsActive ? (gsReady ? " + GEX" : " + GEX（請輸入 flip）") : ""), color.new(color.black, 20))
    string warn = prof == "無" ? "只支援 NQ / ES / TXF / QQQ / SPY" : isES and not esOn ? "ES 預設不交易" : isNQ and tfp == "1" and profSel == "自動" ? "1m 請開 RTH 或選 NQ RTH" : not okTf ? (otherTf ? "不是建議週期（沒回測過）" : "不是建議週期，不交易") : isStock and syminfo.session == session.extended ? "請關延長交易時段" : isStock ? "手續費請改每股約 0.005" : ""
    if warn != ""
        addRow(3, "提示", warn, color.new(color.orange, 20))
